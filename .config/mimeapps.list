[Default Applications]
# Text and Code
text/plain=b1air-text.desktop;nvim.desktop;micro.desktop;
text/markdown=nvim.desktop;micro.desktop;
text/x-c=nvim.desktop;micro.desktop;
text/x-c++=nvim.desktop;micro.desktop;
text/x-python=nvim.desktop;micro.desktop;
text/x-shellscript=nvim.desktop;micro.desktop;
application/json=nvim.desktop;micro.desktop;
application/xml=nvim.desktop;micro.desktop;
application/x-yaml=nvim.desktop;micro.desktop;

# Web & URLs
text/html=firefox.desktop;chromium.desktop;
x-scheme-handler/http=firefox.desktop;chromium.desktop;
x-scheme-handler/https=firefox.desktop;chromium.desktop;
x-scheme-handler/about=firefox.desktop;chromium.desktop;
x-scheme-handler/unknown=firefox.desktop;chromium.desktop;

# File Manager & Directories
inode/directory=b1air-files.desktop;yazi.desktop;

# Images
image/jpeg=b1air-view.desktop;org.gnome.Loupe.desktop;
image/png=b1air-view.desktop;org.gnome.Loupe.desktop;
image/gif=b1air-view.desktop;org.gnome.Loupe.desktop;
image/webp=b1air-view.desktop;org.gnome.Loupe.desktop;
image/svg+xml=b1air-view.desktop;org.gnome.Loupe.desktop;
image/tiff=b1air-view.desktop;org.gnome.Loupe.desktop;
image/heif=b1air-view.desktop;org.gnome.Loupe.desktop;
image/heic=b1air-view.desktop;org.gnome.Loupe.desktop;
image/avif=b1air-view.desktop;org.gnome.Loupe.desktop;
image/jxl=b1air-view.desktop;org.gnome.Loupe.desktop;

# Audio & Video
audio/mpeg=b1air-view.desktop;mpv.desktop;
audio/flac=b1air-view.desktop;mpv.desktop;
audio/ogg=b1air-view.desktop;mpv.desktop;
audio/wav=b1air-view.desktop;mpv.desktop;
video/mp4=b1air-view.desktop;mpv.desktop;
video/mkv=b1air-view.desktop;mpv.desktop;
video/webm=b1air-view.desktop;mpv.desktop;
video/x-matroska=b1air-view.desktop;mpv.desktop;
audio/mp4=b1air-view.desktop;mpv.desktop;
audio/x-m4a=b1air-view.desktop;mpv.desktop;
audio/opus=b1air-view.desktop;mpv.desktop;
video/quicktime=b1air-view.desktop;mpv.desktop;
audio/x-flac=b1air-view.desktop;mpv.desktop;
audio/x-vorbis+ogg=b1air-view.desktop;mpv.desktop;
audio/x-opus+ogg=b1air-view.desktop;mpv.desktop;
audio/x-wav=b1air-view.desktop;mpv.desktop;
audio/aac=b1air-view.desktop;mpv.desktop;
audio/x-aiff=b1air-view.desktop;mpv.desktop;
audio/x-ape=b1air-view.desktop;mpv.desktop;
audio/x-wavpack=b1air-view.desktop;mpv.desktop;
audio/x-ms-wma=b1air-view.desktop;mpv.desktop;
audio/x-matroska=b1air-view.desktop;mpv.desktop;
video/x-msvideo=b1air-view.desktop;mpv.desktop;
video/mpeg=b1air-view.desktop;mpv.desktop;
video/ogg=b1air-view.desktop;mpv.desktop;
video/x-flv=b1air-view.desktop;mpv.desktop;
video/mp2t=b1air-view.desktop;mpv.desktop;
video/3gpp=b1air-view.desktop;mpv.desktop;
video/x-ms-wmv=b1air-view.desktop;mpv.desktop;
video/x-m4v=b1air-view.desktop;mpv.desktop;

# Archives — extraction is built into b1air-files itself (libarchive), no
# separate archive-manager app needed.
application/zip=b1air-files.desktop;
application/x-tar=b1air-files.desktop;
application/x-7z-compressed=b1air-files.desktop;
application/x-rar=b1air-files.desktop;
application/gzip=b1air-files.desktop;
application/x-xz=b1air-files.desktop;
application/x-zstd-compressed-tar=b1air-files.desktop;

# PDF & Documents
application/pdf=zathura.desktop;org.gnome.Evince.desktop;firefox.desktop;

# Terminal
x-scheme-handler/terminal=b1air-term.desktop;

# Windows programs: b1air-run-windows hands them to Bottles, or else Wine
application/x-ms-dos-executable=b1air-run-windows.desktop;com.usebottles.bottles.desktop;wine.desktop;
application/x-msdownload=b1air-run-windows.desktop;com.usebottles.bottles.desktop;wine.desktop;
application/vnd.microsoft.portable-executable=b1air-run-windows.desktop;com.usebottles.bottles.desktop;wine.desktop;
application/x-msi=b1air-run-windows.desktop;com.usebottles.bottles.desktop;wine.desktop;
application/x-ms-shortcut=b1air-run-windows.desktop;wine.desktop;

# Packages: b1air-install-package installs in a terminal, asking first
application/vnd.debian.binary-package=b1air-install-package.desktop;
application/x-deb=b1air-install-package.desktop;
application/x-rpm=b1air-install-package.desktop;
application/x-redhat-package-manager=b1air-install-package.desktop;
application/vnd.appimage=b1air-install-package.desktop;
application/x-iso9660-appimage=b1air-install-package.desktop;
application/vnd.flatpak.ref=b1air-install-package.desktop;
application/vnd.flatpak=b1air-install-package.desktop;
