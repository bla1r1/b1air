{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "  ",
        // ANSI colours, not 24-bit: the terminal maps these to the palette in
        // use, so the keys stay readable on a light theme as on a dark one.
        "color": {
            "keys": "34",
            "title": "34"
        }
    },
    "modules": [
        {
            "type": "title",
            "keyColor": "34",
            "color": {
                "user": "34",
                "at": "90",
                "host": "35"
            }
        },
        "separator",
        {
            "type": "host",
            "key": "PC",
            "keyColor": "36"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "31"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "36"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "33"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "94"
        },
        "separator",
        {
            "type": "os",
            "key": "OS",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "35"
        },
        {
            "type": "bios",
            "key": "BIOS",
            "keyColor": "94"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "36"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "33"
        },
        "separator",
        {
            "type": "de",
            "key": "DE",
            "keyColor": "34"
        },
        {
            "type": "lm",
            "key": "LM",
            "keyColor": "35"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "94"
        },
        {
            "type": "wmtheme",
            "key": "WM Theme",
            "keyColor": "36"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "33"
        },
        "separator",
        {
            "type": "command",
            "key": "OS Age",
            "keyColor": "35",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "94"
        },
        {
            "type": "datetime",
            "key": "DateTime",
            "keyColor": "33"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
