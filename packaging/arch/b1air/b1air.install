post_install() {
    udevadm control --reload-rules 2>/dev/null
    udevadm trigger --name-match=uinput 2>/dev/null
    groupadd -f wallpaper
    install -d -o root -g wallpaper -m 2775 /var/cache/wallpaper
    if [ -f /usr/lib/systemd/system/b1air-fido-uhid.service ]; then
        systemctl daemon-reload
        systemctl enable b1air-fido-uhid.service >/dev/null 2>&1
    fi
    echo ">>> Add yourself to the groups: usermod -aG input,wallpaper,power <user>"
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now b1air-fido-uhid.service >/dev/null 2>&1
    return 0
}
