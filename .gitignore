# macOS Finder metadata & resource forks
.DS_Store
._*

# Build output. Everything is built into src/build by CMake; the other names
# are what the hand-written daemon build and the old per-shell CMake tree left
# in checkouts that predate it.
build/
*.o
src/daemon/*.d
src/b1air-daemon
src/b1air-polkit-agent
src/b1air-secret-service
src/shell/build/
tools/controller

# Notes for the coding assistant working in this repository. Kept out of the
# tree on purpose: it is guidance for a tool, not part of the desktop, and it
# names paths on this machine.
CLAUDE.md
