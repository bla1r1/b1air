From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: b1air <dimazzzzz342@gmail.com>
Date: Sat, 3 Oct 2026 20:57:55 +0000
Subject: [PATCH] Add wlr_scene_tree_set_scale: draw a tree scaled

A tree can be drawn at a scale: its children's positions and sizes are
multiplied by it (and by any ancestor's), around the tree's own position.
It is a drawing transform only: clients keep their size and keep
drawing, which is what a live workspace overview needs and what the
scene could not do (a buffer has a destination size; a tree had nothing).

Positions, sizes, visibility, the render list, hit testing
(wlr_scene_node_at, in the node's own coordinates) and output
enter/leave all follow the scale. A scaled node is drawn blended (its
opaque region is in unscaled terms) and is never scanned out. While any
tree is scaled, damage is not tracked by region: every change redraws
whole outputs, which suits the short-lived effects this is for.
---
 include/scenefx/types/wlr_scene.h |  16 +++
 types/scene/wlr_scene.c           | 161 +++++++++++++++++++++++++-----
 2 files changed, 153 insertions(+), 24 deletions(-)

diff --git a/include/scenefx/types/wlr_scene.h b/include/scenefx/types/wlr_scene.h
index ac1bc49..4ebc2b6 100644
--- a/include/scenefx/types/wlr_scene.h
+++ b/include/scenefx/types/wlr_scene.h
@@ -462,6 +462,22 @@ void wlr_scene_set_color_manager_v1(struct wlr_scene *scene, struct wlr_color_ma
  */
 struct wlr_scene_tree *wlr_scene_tree_create(struct wlr_scene_tree *parent);
 
+/**
+ * Draw a tree at a scale: everything in it is drawn that much smaller (or
+ * larger), around the tree's own position. This is a drawing transform only:
+ * clients are not told, keep their size, and keep drawing — a workspace
+ * overview shows live windows this way. Input is not transformed: a caller
+ * that scales a tree handles the pointer over it itself.
+ *
+ * While any tree is scaled, damage is not tracked per region: every change
+ * redraws whole outputs. Meant for short-lived effects, on a few trees.
+ *
+ * The scale is kept beside the scene, not in struct wlr_scene_tree: the
+ * scene's structs must keep wlroots' layout, since wlroots' own scene code
+ * can end up handed these objects.
+ */
+void wlr_scene_tree_set_scale(struct wlr_scene_tree *tree, float scale);
+
 /**
  * Add a node displaying a single surface to the scene-graph.
  *
diff --git a/types/scene/wlr_scene.c b/types/scene/wlr_scene.c
index 91d39c4..d2d111f 100644
--- a/types/scene/wlr_scene.c
+++ b/types/scene/wlr_scene.c
@@ -1,4 +1,5 @@
 #include <assert.h>
+#include <math.h>
 #include <pixman.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -80,6 +81,33 @@ struct wlr_scene_blur *wlr_scene_blur_from_node(struct wlr_scene_node *node) {
 	return blur;
 }
 
+// Trees drawn at a scale other than 1 (wlr_scene_tree_set_scale), beside the
+// structs rather than in them: see the header. A handful at most.
+#define SCENE_SCALED_TREES_MAX 64
+static struct {
+	struct wlr_scene_tree *tree;
+	float scale;
+} scaled_trees[SCENE_SCALED_TREES_MAX];
+static int scaled_tree_count = 0;
+
+static float scene_tree_scale(const struct wlr_scene_tree *tree) {
+	for (int i = 0; i < scaled_tree_count; i++) {
+		if (scaled_trees[i].tree == tree) {
+			return scaled_trees[i].scale;
+		}
+	}
+	return 1.0f;
+}
+
+static void scene_tree_forget_scale(const struct wlr_scene_tree *tree) {
+	for (int i = 0; i < scaled_tree_count; i++) {
+		if (scaled_trees[i].tree == tree) {
+			scaled_trees[i] = scaled_trees[--scaled_tree_count];
+			return;
+		}
+	}
+}
+
 struct wlr_scene *scene_node_get_root(struct wlr_scene_node *node) {
 	struct wlr_scene_tree *tree;
 	if (node->type == WLR_SCENE_NODE_TREE) {
@@ -140,6 +168,9 @@ void wlr_scene_node_destroy(struct wlr_scene_node *node) {
 	wlr_scene_node_set_enabled(node, false);
 
 	struct wlr_scene *scene = scene_node_get_root(node);
+	if (node->type == WLR_SCENE_NODE_TREE) {
+		scene_tree_forget_scale(wlr_scene_tree_from_node(node));
+	}
 	if (node->type == WLR_SCENE_NODE_BUFFER) {
 		struct wlr_scene_buffer *scene_buffer = wlr_scene_buffer_from_node(node);
 
@@ -238,6 +269,37 @@ struct wlr_scene *wlr_scene_create(void) {
 	return scene;
 }
 
+static void scene_node_update(struct wlr_scene_node *node, pixman_region32_t *damage);
+
+void wlr_scene_tree_set_scale(struct wlr_scene_tree *tree, float scale) {
+	const float now = scene_tree_scale(tree);
+	if (scale <= 0.0f || now == scale) {
+		return;
+	}
+	if (now == 1.0f) {
+		if (scaled_tree_count == SCENE_SCALED_TREES_MAX) {
+			wlr_log(WLR_ERROR, "Too many scaled scene trees");
+			return;
+		}
+		scaled_trees[scaled_tree_count].tree = tree;
+		scaled_trees[scaled_tree_count].scale = scale;
+		scaled_tree_count++;
+	} else {
+		for (int i = 0; i < scaled_tree_count; i++) {
+			if (scaled_trees[i].tree == tree) {
+				scaled_trees[i].scale = scale;
+			}
+		}
+	}
+	// Everything is looked at again (scene_node_update, with a scaled tree
+	// about) and the outputs redrawn whole.
+	scene_node_update(&tree->node, NULL);
+	if (scale == 1.0f) {
+		scene_tree_forget_scale(tree);
+		scene_node_update(&tree->node, NULL);
+	}
+}
+
 struct wlr_scene_tree *wlr_scene_tree_create(struct wlr_scene_tree *parent) {
 	assert(parent);
 
@@ -250,11 +312,14 @@ struct wlr_scene_tree *wlr_scene_tree_create(struct wlr_scene_tree *parent) {
 	return tree;
 }
 
+// `scale` is what the node is drawn at: the product of its ancestors' tree
+// scales (wlr_scene_tree_set_scale). A node's size is multiplied by it; its
+// position (sx, sy) already is.
