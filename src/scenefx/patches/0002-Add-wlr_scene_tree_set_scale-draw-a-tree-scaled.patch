+		const float inner = scale * scene_tree_scale(scene_tree);
 		struct wlr_scene_node *child;
 		wl_list_for_each_reverse(child, &scene_tree->children, link) {
-			if (_scene_nodes_in_box(child, box, iterator, user_data, lx + child->x, ly + child->y)) {
+			if (_scene_nodes_in_box(child, box, iterator, user_data,
+					lx + (int)lroundf(child->x * inner), ly + (int)lroundf(child->y * inner), inner)) {
 				return true;
 			}
 		}
@@ -276,9 +343,11 @@ static bool _scene_nodes_in_box(struct wlr_scene_node *node, struct wlr_box *box
 	case WLR_SCENE_NODE_BLUR:;
 		struct wlr_box node_box = { .x = lx, .y = ly };
 		scene_node_get_size(node, &node_box.width, &node_box.height);
+		node_box.width = (int)lroundf(node_box.width * scale);
+		node_box.height = (int)lroundf(node_box.height * scale);
 
 		if (wlr_box_intersection(&node_box, &node_box, box) &&
-				iterator(node, lx, ly, user_data)) {
+				iterator(node, lx, ly, scale, user_data)) {
 			return true;
 		}
 		break;
@@ -287,12 +356,22 @@ static bool _scene_nodes_in_box(struct wlr_scene_node *node, struct wlr_box *box
 	return false;
 }
 
+// The scale `node` is drawn at, from its ancestors' trees (not its own).
+static float scene_node_parent_scale(struct wlr_scene_node *node) {
+	float scale = 1.0f;
+	for (struct wlr_scene_tree *t = node->parent; t; t = t->node.parent) {
+		scale *= scene_tree_scale(t);
+	}
+	return scale;
+}
+
 static bool scene_nodes_in_box(struct wlr_scene_node *node, struct wlr_box *box,
 		scene_node_box_iterator_func_t iterator, void *user_data) {
 	int x, y;
 	wlr_scene_node_coords(node, &x, &y);
 
-	return _scene_nodes_in_box(node, box, iterator, user_data, x, y);
+	return _scene_nodes_in_box(node, box, iterator, user_data, x, y,
+		scene_node_parent_scale(node));
 }
 
 static pixman_region32_t create_corner_location_region(struct fx_corner_radii corners, int x, int y, int width, int height) {
@@ -475,7 +554,14 @@ static void scene_output_damage(struct wlr_scene_output *scene_output,
 
 	pixman_region32_t clipped;
 	pixman_region32_init(&clipped);
-	pixman_region32_intersect_rect(&clipped, damage, 0, 0, output->width, output->height);
+	// With a scaled tree, damage is not tracked by region: positions and
+	// sizes below it are not where the damage was computed, so any change
+	// redraws the output (wlr_scene_tree_set_scale).
+	if (scaled_tree_count > 0 && !pixman_region32_empty(damage)) {
+		pixman_region32_init_rect(&clipped, 0, 0, output->width, output->height);
+	} else {
+		pixman_region32_intersect_rect(&clipped, damage, 0, 0, output->width, output->height);
+	}
 
 	if (!pixman_region32_empty(&clipped)) {
 		wlr_output_schedule_frame(scene_output->output);
@@ -675,7 +761,7 @@ static void restack_xwayland_surface(struct wlr_scene_node *node,
 #endif
 
