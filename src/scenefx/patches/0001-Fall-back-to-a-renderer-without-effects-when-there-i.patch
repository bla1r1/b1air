-		if (fx_pass->has_blur && is_scene_blur_enabled(&scene->blur_data)
+		if (fx_pass != NULL && fx_pass->has_blur && is_scene_blur_enabled(&scene->blur_data)
 				&& scene_blur->dirty) {
 			const float opacity = 1.0f;
 			enum wl_output_transform transform =
@@ -2191,6 +2205,9 @@ static void scene_entry_render(struct render_list_entry *entry, const struct ren
 		}
 		break;
 	case WLR_SCENE_NODE_BLUR:;
+		if (fx_pass == NULL) {
+			break;
+		}
 		struct wlr_scene_blur *blur = wlr_scene_blur_from_node(node);
 
 		struct wlr_texture *tex = NULL;
@@ -3290,9 +3307,11 @@ bool wlr_scene_output_build_state(struct wlr_scene_output *scene_output,
 	wlr_damage_ring_rotate_buffer(&scene_output->damage_ring, buffer,
 		&render_data.damage);
 
-	struct fx_gles_render_pass *fx_pass = fx_get_render_pass(render_pass);
+	// Without effects there is no blur, and nothing to compensate for.
+	struct fx_gles_render_pass *fx_pass = wlr_renderer_is_fx(output->renderer) ?
+		fx_get_render_pass(render_pass) : NULL;
 	bool should_compensate_blur = false;
-	if (fx_render_pass_init_offscreen_buffers(render_pass, output)
+	if (fx_pass != NULL && fx_render_pass_init_offscreen_buffers(render_pass, output)
 			&& pixman_region32_not_empty(&render_data.damage)) {
 		// Blur artifact prevention
 		// Note: Supports individual blur node blur_data
