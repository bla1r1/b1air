From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: b1air <dimazzzzz342@gmail.com>
Date: Sat, 3 Oct 2026 12:19:23 +0000
Subject: [PATCH] Fall back to a renderer without effects when there is no
 GLES2

Without a GPU (a virtual machine with no 3D, a broken driver, no /dev/dri)
fx_renderer_create failed and the compositor could not start at all. Fall
back to wlroots' own renderer choice, which ends in its software renderer,
and have the scene draw plain rects and textures through it: windows,
layouts and animations work; blur, shadows and rounded corners are left
out. WLR_RENDERER=pixman asks for the fallback outright.
---
 render/fx_renderer/fx_renderer.c | 22 +++++++++++++++++++++-
 types/scene/wlr_scene.c          | 31 +++++++++++++++++++++++++------
 2 files changed, 46 insertions(+), 7 deletions(-)

diff --git a/render/fx_renderer/fx_renderer.c b/render/fx_renderer/fx_renderer.c
index 8d0a7b2..4847085 100644
--- a/render/fx_renderer/fx_renderer.c
+++ b/render/fx_renderer/fx_renderer.c
@@ -8,11 +8,13 @@
 #include <GLES2/gl2.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 #include <unistd.h>
 #include <wlr/backend.h>
 #include <wlr/render/allocator.h>
 #include <wlr/render/egl.h>
 #include <wlr/render/interface.h>
+#include <wlr/render/wlr_renderer.h>
 #include <wlr/util/box.h>
 #include <wlr/util/log.h>
 #include <xf86drm.h>
@@ -350,8 +352,26 @@ struct wlr_renderer *fx_renderer_create_with_drm_fd(int drm_fd) {
 	return renderer_autocreate(NULL, drm_fd);
 }
 
+// Without a GPU (a virtual machine with no 3D, a broken driver, a missing
+// /dev/dri) there is no GLES2 and so no FX renderer. Rather than leave the
+// compositor unable to start, fall back to wlroots' own choice, which ends in
+// its software renderer: windows, layouts and animations still draw, only
+// blur, shadows and rounded corners are left out (see scene_entry_render).
+// WLR_RENDERER=pixman asks for the fallback outright.
 struct wlr_renderer *fx_renderer_create(struct wlr_backend *backend) {
-	return renderer_autocreate(backend, -1);
+	const char *wanted = getenv("WLR_RENDERER");
+	if (wanted == NULL || strcmp(wanted, "gles2") == 0) {
+		struct wlr_renderer *renderer = renderer_autocreate(backend, -1);
+		if (renderer != NULL || wanted != NULL) {
+			return renderer;
+		}
+		wlr_log(WLR_ERROR, "No GLES2: falling back to a renderer without effects");
+	}
+	struct wlr_renderer *renderer = wlr_renderer_autocreate(backend);
+	if (renderer != NULL) {
+		wlr_log(WLR_INFO, "Rendering without effects: no blur, shadows or rounded corners");
+	}
+	return renderer;
 }
 
 static bool link_shaders(struct fx_renderer *renderer) {
