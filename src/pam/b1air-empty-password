#!/bin/sh
# b1air-empty-password — for pam_exec with expose_authtok, in the login
# screen's PAM file when Settings → User → "Fingerprint at the login screen"
# is on (b1air-daemon fingerprint login on). Succeeds when the password given
# is empty: an empty password goes to the fingerprint reader, a typed one
# straight on to the password check, without waiting for the reader first.
# pam_exec writes the password followed by a NUL byte.
[ "$(tr -d '\000' | head -c 1 | wc -c)" -eq 0 ]
