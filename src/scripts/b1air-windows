#!/usr/bin/env python3
# =============================================================================
# b1air-windows — Windows programs as programs: each in a prefix of its own,
# run with Proton through umu-launcher, in the Launchpad with its own icon.
#
#   inspect FILE              what a .exe/.msi is: its name, icon, installer or not,
#                             and where it is recommended to go, with which Proton (JSON)
#   open FILE                 what Files opens a Windows file with: the shell's sheet,
#                             or the recommended way when the shell is not up
#   install FILE [OPTIONS]    run an installer; its Start menu shortcuts become
#                             Launchpad entries. OPTIONS: --name NAME, and where:
#                             --bottle ID, or --new-bottle NAME [--runner PROTON];
#                             the shared bottle when neither is given
#   add FILE [OPTIONS]        a program that needs no installing, as an entry
#   once FILE [--bottle ID]   run it once, with no entry
#   run SLUG [LAUNCHER] [ARG…]  start an entry (what its desktop file runs)
#   pick SLUG PATH            after an install with no shortcuts: what to start
#   list                      every program, its launchers and options (JSON)
#   bottles                   every bottle: its Proton, components, programs (JSON)
#   set SLUG KEY on|off       a program's option: dxvk wayland hdr fsr mangohud
#                             gamemode gamescope game; or set SLUG name NAME
#   bottle-set ID KEY VALUE   a bottle's runner (GE-Proton, UMU-Proton, a folder) or name
#   deps ID VERB…             Windows components into a bottle (winetricks verbs)
#   config ID                 Wine's own settings for a bottle (winecfg)
#   log SLUG                  where a program's last run's output is
#   remove SLUG               a program: its own bottle with it, or its uninstaller
#                             and its entries when it shares one
#   bottle-remove ID          a bottle and every program in it
#   runtime [update]          umu and Proton: what there is (JSON); update fetches the latest
#
# A bottle is a Wine prefix with its Proton and its components. Programs go
# into the shared one unless asked: one place, one set of components. A game
# that wants another Proton, or that breaks the others, gets one of its own.
#
# Proton is the Wine Valve builds for Steam, with DXVK and VKD3D-Proton
# (Direct3D over Vulkan); umu-launcher runs it outside Steam, in Valve's
# runtime container, and applies the fixes of the umu database to the games
# it knows. GE-Proton, the community build with more fixes, is fetched by umu
# the first time and kept up to date. All of it is open source.
#
# Kept under $XDG_DATA_HOME/b1air/windows/: <slug>/ for each program (app.json,
# its icons, last.log) and _bottles/<id>/ for each bottle (bottle.json, prefix/).
# Python's standard library only.
# =============================================================================

import csv
import hashlib
import json
import os
import re
import shutil
import socket
import struct
import subprocess
import sys
import time
import urllib.request
import zlib
from pathlib import Path

socket.setdefaulttimeout(30)  # downloads give up rather than hang

HOME = Path.home()
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
ROOT = DATA / "b1air" / "windows"
APPS_DIR = DATA / "applications"
COMPAT_TOOLS = DATA / "Steam" / "compatibilitytools.d"

# The options each program has, and what they are when not set.
DEFAULT_OPTIONS = {
    "dxvk": True,            # Direct3D over Vulkan; off: Wine's own, over OpenGL
    "wayland": False,        # Wine's Wayland driver: sharp on HiDPI, still new
    "hdr": False,
    "fsr": False,            # AMD FSR upscaling for fullscreen games
    "mangohud": False,
    "gamemode": False,
    "gamescope": False,      # its own compositor, for games that misbehave
    "game": False,           # a game: in the Launchpad's Games
}
BOOL_OPTIONS = [k for k, v in DEFAULT_OPTIONS.items() if isinstance(v, bool)]

