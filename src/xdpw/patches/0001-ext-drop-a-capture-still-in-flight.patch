diff --git a/src/screencast/ext_image_copy.c b/src/screencast/ext_image_copy.c
index afdfcd9..7c02c24 100644
--- a/src/screencast/ext_image_copy.c
+++ b/src/screencast/ext_image_copy.c
@@ -294,6 +294,17 @@ static void ext_register_frame_cb(struct xdpw_screencast_instance *cast) {
 			return;
 		}
 	}
+	// A session holds one frame at a time, and asking for a second is a
+	// protocol error that takes the whole portal down. One can still be in
+	// flight here: the stream paused (its buffer went back to PipeWire) and
+	// streams again before that capture finished, or a throttled capture
+	// fires while another runs. That capture's buffer is no longer ours to
+	// fill, so it is dropped and this one takes its place.
+	if (cast->ext_session.frame) {
+		logprint(DEBUG, "ext: dropping a capture still in flight");
+		ext_image_copy_capture_frame_v1_destroy(cast->ext_session.frame);
+		cast->ext_session.frame = NULL;
+	}
 	cast->ext_session.frame = ext_image_copy_capture_session_v1_create_frame(
 			cast->ext_session.capture_session);
 	ext_image_copy_capture_frame_v1_add_listener(cast->ext_session.frame,
