[Desktop Entry]
Exec=b1air-files %U
Icon=b1air-files
Terminal=false
Type=Application
Name=Files
Name[uk]=Файли
Name[ru]=Файлы
GenericName=File Manager
GenericName[uk]=Файловий менеджер
GenericName[ru]=Файловый менеджер
Comment=Browse, copy and organise files
Comment[uk]=Перегляд, копіювання й упорядкування файлів
Comment[ru]=Просмотр, копирование и упорядочивание файлов
Keywords=files;folders;explorer;trash;
Keywords[uk]=файли;теки;провідник;кошик;
Keywords[ru]=файлы;папки;проводник;корзина;
Categories=System;FileTools;FileManager;
MimeType=inode/directory;application/zip;application/x-tar;application/x-7z-compressed;application/x-rar;application/gzip;application/x-xz;application/x-zstd-compressed-tar;
StartupNotify=true
StartupWMClass=b1air-files
