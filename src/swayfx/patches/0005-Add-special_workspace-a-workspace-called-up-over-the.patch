diff --git a/sway/commands/special_workspace.c b/sway/commands/special_workspace.c
new file mode 100644
index 00000000..b1348740
--- /dev/null
+++ b/sway/commands/special_workspace.c
@@ -0,0 +1,76 @@
+#include <stdlib.h>
+#include <string.h>
+#include "sway/commands.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/workspace.h"
+#include "log.h"
+
+// special_workspace toggle|show|hide
+//
+// Hyprland's special workspace: a workspace of its own (named "special")
+// that is called up over the one in front of you and put away again, the
+// one beneath staying in view, dimmed. Windows go to it the usual way:
+// `move container to workspace special`.
+struct cmd_results *cmd_special_workspace(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "special_workspace", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_seat *seat = config->handler_context.seat;
+	struct sway_workspace *current = seat ? seat_get_focused_workspace(seat) : NULL;
+	if (!current || !current->output) {
+		return cmd_results_new(CMD_FAILURE, "No workspace to show it over");
+	}
+	struct sway_output *output = current->output;
+
+	bool shown = workspace_is_special(current);
+	bool want;
+	if (strcmp(argv[0], "toggle") == 0) {
+		want = !shown;
+	} else if (strcmp(argv[0], "show") == 0) {
+		want = true;
+	} else if (strcmp(argv[0], "hide") == 0) {
+		want = false;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'special_workspace toggle|show|hide'");
+	}
+	if (want == shown) {
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+
+	struct sway_workspace *target;
+	if (want) {
+		target = workspace_by_name(SPECIAL_WORKSPACE_NAME);
+		if (target && target->output != output) {
+			// Shown on the screen it is called up on: it follows.
+			struct sway_output *old_output = target->output;
+			workspace_move_to_output(target, output);
+			arrange_output(old_output);
+		}
+		if (!target) {
+			target = workspace_create(output, SPECIAL_WORKSPACE_NAME);
+		}
+		if (!target) {
+			return cmd_results_new(CMD_FAILURE, "Could not create the special workspace");
+		}
+		free(output->special_under);
+		output->special_under = strdup(current->name);
+	} else {
+		// Back to the one beneath; if it has gone (it was empty, and sway
+		// drops empty workspaces it leaves), the same name again.
+		const char *under = output->special_under;
+		target = under ? workspace_by_name(under) : NULL;
+		if (!target && under) {
+			target = workspace_create(output, under);
+		}
+		if (!target) {
+			return cmd_results_new(CMD_FAILURE, "No workspace to go back to");
+		}
+	}
+	workspace_switch(target);
+	seat_consider_warp_to_focus(seat);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
diff --git a/sway/desktop/transaction.c b/sway/desktop/transaction.c
index 567db3e1..a09e9159 100644
--- a/sway/desktop/transaction.c
+++ b/sway/desktop/transaction.c
@@ -1006,6 +1006,22 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		&& output->wlr_output->enabled && config->animation_duration_ms > 0 &&
 		!(old_active->current.fullscreen || new_active->current.fullscreen);
 
+	// b1air: the special workspace appears over the one it was opened from,
+	// which stays drawn, dimmed, beneath it: no slide or fade either way.
+	struct sway_workspace *special_under = NULL;
+	if (workspace_is_special(new_active) && output->special_under) {
+		special_under = workspace_by_name(output->special_under);
+		if (special_under && special_under->output != output) {
+			special_under = NULL;
+		}
+	}
+	if (workspace_is_special(old_active) || workspace_is_special(new_active)) {
+		is_ws_switch = false;
+		if (old_active) {
+			finish_animation(&old_active->animation_state.animation);
+		}
+	}
+
 	if (is_ws_switch && config->workspace_animation == WORKSPACE_ANIMATION_SLIDE) {
 		start_workspace_slide(output, old_active, new_active);
 	} else if (is_ws_switch) {
@@ -1043,6 +1059,11 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		// b1air: a workspace held beside the active one by a swipe is shown
 		// the way one sliding or fading out is.
 		bool animating = child->animation_state.animation.initialized || child->swipe_peek;
+		// b1air: under the special workspace: drawn, but its floating
+		// windows (in the shared floating layer, above every workspace's
+		// tiling) would cover the special one's, so they stay hidden.
+		bool under_special = child == special_under;
+		animating = animating || under_special;
 
 		wlr_scene_node_reparent(&child->layers.tiling->node, output->layers.tiling);
 		wlr_scene_node_reparent(&child->layers.fullscreen->node, output->layers.fullscreen);
@@ -1050,7 +1071,8 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		for (int i = 0; i < child->current.floating->length; i++) {
 			struct sway_container *floater = child->current.floating->items[i];
 			wlr_scene_node_reparent(&floater->scene_tree->node, root->layers.floating);
-			wlr_scene_node_set_enabled(&floater->scene_tree->node, activated || animating);
+			wlr_scene_node_set_enabled(&floater->scene_tree->node,
+				activated || (animating && !under_special));
 		}
 
 		if (activated) {
@@ -1115,6 +1137,17 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		}
 	}
 
+	if (special_under && !new_active->current.fullscreen) {
+		// Bottom to top: the workspace beneath, the dimming, the special one.
+		wlr_scene_rect_set_size(output->special_dim, width, height);
+		wlr_scene_node_raise_to_top(&special_under->layers.tiling->node);
+		wlr_scene_node_raise_to_top(&output->special_dim->node);
+		wlr_scene_node_raise_to_top(&new_active->layers.tiling->node);
+		wlr_scene_node_set_enabled(&output->special_dim->node, true);
+	} else {
+		wlr_scene_node_set_enabled(&output->special_dim->node, false);
+	}
+
 	output->prev_active_workspace = new_active;
 }
 
diff --git a/sway/desktop/workspace_swipe.c b/sway/desktop/workspace_swipe.c
index 1c9df2d7..ff4f0202 100644
--- a/sway/desktop/workspace_swipe.c
+++ b/sway/desktop/workspace_swipe.c
@@ -64,8 +64,13 @@ static struct sway_workspace *neighbour(struct sway_workspace *ws, int dir) {
 	list_t *list = ws->output->workspaces;
 	for (int i = 0; i < list->length; i++) {
 		if (list->items[i] == ws) {
-			int j = i + dir;
-			return j >= 0 && j < list->length ? list->items[j] : NULL;
+			// b1air: past the special workspace, which is never swiped to.
+			for (int j = i + dir; j >= 0 && j < list->length; j += dir) {
+				if (!workspace_is_special(list->items[j])) {
+					return list->items[j];
+				}
+			}
+			return NULL;
 		}
 	}
 	return NULL;
