+		output->special_dim = wlr_scene_rect_create(
+			output->layers.tiling, 0, 0, (float[4]){0.f, 0.f, 0.f, 0.45f});
+		if (!output->special_dim) {
+			sway_log(SWAY_ERROR, "Unable to allocate a dimming rect");
+			failed = true;
+		} else {
+			wlr_scene_node_set_enabled(&output->special_dim->node, false);
+		}
+	}
+
 	if (failed) {
 		destroy_scene_layers(output);
 		wlr_scene_output_destroy(output->scene_output);
@@ -278,6 +292,7 @@ void output_destroy(struct sway_output *output) {
 	list_free(output->workspaces);
 	list_free(output->current.workspaces);
 	wlr_color_transform_unref(output->color_transform);
+	free(output->special_under);
 	free(output);
 }
 
