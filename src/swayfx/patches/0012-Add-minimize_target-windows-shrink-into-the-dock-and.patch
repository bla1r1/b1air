+#include <stdbool.h>
+#include <wlr/util/box.h>
+
+struct sway_container;
+
+// b1air: a window sent to the scratchpad shrinks into where it is kept — its
+// minimize_target, the dock's icon for it, or the bottom of its output —
+// and comes back out of it when shown. With animation_duration_ms and a
+// window_animation other than none.
+
