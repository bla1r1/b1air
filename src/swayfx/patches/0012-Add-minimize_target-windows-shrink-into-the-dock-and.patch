diff --git a/sway/tree/root.c b/sway/tree/root.c
index 7a5bac4..c55d3bf 100644
--- a/sway/tree/root.c
+++ b/sway/tree/root.c
@@ -13,6 +13,7 @@
 #include "sway/tree/arrange.h"
 #include "sway/tree/container.h"
 #include "sway/tree/root.h"
+#include "sway/desktop/minimize.h"
 #include "sway/tree/workspace.h"
 #include "list.h"
 #include "log.h"
@@ -123,6 +124,11 @@ void root_scratchpad_add_container(struct sway_container *con, struct sway_works
 	struct sway_container *parent = con->pending.parent;
 	struct sway_workspace *workspace = con->pending.workspace;
 
+	// b1air: shrinks into the dock as it goes, when it is hidden
+	if (!ws) {
+		minimize_animate_away(con);
+	}
+
 	set_container_transform(workspace, con);
 
 	// Clear the fullscreen mode when sending to the scratchpad
@@ -163,6 +169,8 @@ void root_scratchpad_add_container(struct sway_container *con, struct sway_works
 		root_scratchpad_set_minimize(con, true);
 	}
 
+	minimize_animate_away(con); // b1air: into the dock
+
 	ipc_event_window(con, "move");
 }
 
@@ -216,6 +224,9 @@ void root_scratchpad_show(struct sway_container *con) {
