diff --git a/sway/desktop/workspace_swipe.c b/sway/desktop/workspace_swipe.c
new file mode 100644
index 00000000..1c9df2d7
--- /dev/null
+++ b/sway/desktop/workspace_swipe.c
@@ -0,0 +1,305 @@
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sway/animation_manager.h"
+#include "sway/config.h"
+#include "sway/desktop/workspace_swipe.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/root.h"
+#include "sway/tree/workspace.h"
+#include "sway/commands.h"
+#include "sway/input/input-manager.h"
+#include "log.h"
+
+// Touchpad units (about a pixel each, before acceleration) the fingers move
+// before the swipe counts as horizontal or vertical.
+#define DECIDE_DISTANCE 12.0
+// How far across the screen a release has to be to switch.
+#define COMMIT_FRACTION 0.2
+// Or how fast it has to be moving towards the neighbour (units per ms): a
+// flick switches however short it was.
+#define FLICK_SPEED 0.6
+// Past the last workspace the screen still gives a little, this much at
+// most, so the swipe does not feel dead.
+#define EDGE_GIVE 0.06
+
+static struct {
+	enum { SWIPE_IDLE, SWIPE_DECIDING, SWIPE_ACTIVE, SWIPE_IGNORED } state;
+	uint32_t fingers;
+	double dx, dy;
+	double velocity;
+	uint32_t last_time;
+	struct sway_output *output;
+	struct sway_workspace *from;
+	struct sway_workspace *peek;
+	int span;
+} swipe;
+
+static bool output_alive(struct sway_output *output) {
+	for (int i = 0; root && i < root->outputs->length; i++) {
+		if (root->outputs->items[i] == output) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool workspace_alive(struct sway_output *output, struct sway_workspace *ws) {
+	if (!ws || !output_alive(output) || ws->node.destroying) {
+		return false;
+	}
+	for (int i = 0; i < output->workspaces->length; i++) {
+		if (output->workspaces->items[i] == ws) {
+			return true;
+		}
+	}
+	return false;
+}
+
+// The workspace beside `ws` on its output: dir -1 the one before, +1 after.
+// No wrapping round: past the last one there is nothing to show.
+static struct sway_workspace *neighbour(struct sway_workspace *ws, int dir) {
+	list_t *list = ws->output->workspaces;
+	for (int i = 0; i < list->length; i++) {
+		if (list->items[i] == ws) {
+			int j = i + dir;
+			return j >= 0 && j < list->length ? list->items[j] : NULL;
+		}
+	}
+	return NULL;
+}
+
+static void stop_slide(struct sway_workspace *ws) {
+	finish_animation(&ws->animation_state.animation);
+	ws->animation_state.from_x = ws->animation_state.to_x = 0;
+}
+
+static void set_peek(struct sway_workspace *target) {
+	if (target == swipe.peek) {
+		return;
+	}
+	if (swipe.peek && workspace_alive(swipe.output, swipe.peek)) {
+		swipe.peek->swipe_peek = false;
+		swipe.peek->swipe_offset = 0;
+	}
+	swipe.peek = target;
+	if (target) {
+		stop_slide(target);
+		target->swipe_peek = true;
+	}
+	// Shown or hidden, laid out by the usual arrangement.
+	arrange_output(swipe.output);
+}
+
+static void apply(void) {
+	double offset = swipe.dx * (config->workspace_swipe_invert ? -1.0 : 1.0);
+	// Content follows the fingers: moving right brings in the one before.
+	struct sway_workspace *target = neighbour(swipe.from, offset > 0 ? -1 : 1);
+	if (!target) {
+		double give = swipe.span * EDGE_GIVE;
+		offset = copysign(give * (1.0 - exp(-fabs(offset) / give)), offset);
+	} else if (fabs(offset) > swipe.span) {
+		offset = copysign(swipe.span, offset);
+	}
+	set_peek(target);
+
+	swipe.from->swipe_offset = (int)lround(offset);
+	workspace_place(swipe.from);
+	if (swipe.peek) {
+		swipe.peek->swipe_offset = swipe.from->swipe_offset
+			+ (offset > 0 ? -swipe.span : swipe.span);
+		workspace_place(swipe.peek);
+	}
+}
+
+static bool activate(struct sway_seat *seat) {
+	struct sway_workspace *ws = seat_get_focused_workspace(seat);
+	if (!ws || !ws->output || ws->fullscreen || root->fullscreen_global) {
+		return false;
+	}
+	swipe.output = ws->output;
+	swipe.from = ws;
+	swipe.peek = NULL;
+	swipe.span = ws->output->usable_area.width > 0
+		? ws->output->usable_area.width : ws->output->width;
+	stop_slide(ws);
+	return true;
+}
+
+bool workspace_swipe_begin(struct sway_seat *seat, uint32_t fingers) {
+	if (config->workspace_swipe_fingers == 0 || fingers != config->workspace_swipe_fingers) {
+		return false;
+	}
+	if (swipe.state == SWIPE_ACTIVE) {
+		workspace_swipe_end(seat, true);
+	}
+	swipe.state = SWIPE_DECIDING;
+	swipe.fingers = fingers;
+	swipe.dx = swipe.dy = 0;
+	swipe.velocity = 0;
+	swipe.last_time = 0;
+	return true;
+}
+
+enum workspace_swipe_result workspace_swipe_update(struct sway_seat *seat,
+		double dx, double dy, uint32_t time_msec,
+		uint32_t *fingers, double *acc_dx, double *acc_dy) {
+	switch (swipe.state) {
+	case SWIPE_IDLE:
+		return WORKSPACE_SWIPE_NOT_OURS;
+	case SWIPE_IGNORED:
+		return WORKSPACE_SWIPE_CONSUMED;
+	case SWIPE_DECIDING:
+		swipe.dx += dx;
+		swipe.dy += dy;
+		if (hypot(swipe.dx, swipe.dy) < DECIDE_DISTANCE) {
+			return WORKSPACE_SWIPE_CONSUMED;
+		}
+		if (fabs(swipe.dy) > fabs(swipe.dx)) {
+			*fingers = swipe.fingers;
+			*acc_dx = swipe.dx;
+			*acc_dy = swipe.dy;
+			swipe.state = SWIPE_IDLE;
+			return WORKSPACE_SWIPE_HANDOVER;
+		}
+		if (!activate(seat)) {
+			swipe.state = SWIPE_IGNORED;
+			return WORKSPACE_SWIPE_CONSUMED;
+		}
+		swipe.state = SWIPE_ACTIVE;
+		swipe.last_time = time_msec;
+		apply();
+		return WORKSPACE_SWIPE_CONSUMED;
+	case SWIPE_ACTIVE:
+		if (!workspace_alive(swipe.output, swipe.from)) {
+			swipe.state = SWIPE_IGNORED;
+			return WORKSPACE_SWIPE_CONSUMED;
+		}
+		swipe.dx += dx;
+		if (time_msec > swipe.last_time) {
+			double instant = dx / (double)(time_msec - swipe.last_time);
+			swipe.velocity = 0.6 * swipe.velocity + 0.4 * instant;
+		}
+		swipe.last_time = time_msec;
+		apply();
+		return WORKSPACE_SWIPE_CONSUMED;
+	}
+	return WORKSPACE_SWIPE_NOT_OURS;
+}
+
+static void back_from_complete(void *data) {
+	struct sway_workspace *ws = data;
+	ws->animation_state.from_x = ws->animation_state.to_x = 0;
+	workspace_place(ws);
+}
+
+static void back_peek_complete(void *data) {
+	struct sway_workspace *ws = data;
+	ws->animation_state.from_x = ws->animation_state.to_x = 0;
+	ws->swipe_peek = false;
+	ws->swipe_offset = 0;
+	if (ws->output) {
+		arrange_output(ws->output);
+	}
+}
+
+static void slide_update(void *data) {
+	workspace_place(data);
+}
+
+// Both back where they were: the active one to the middle, the neighbour
+// out of sight, then hidden.
+static void slide_back(void) {
+	struct sway_workspace *from = swipe.from;
+	from->animation_state.from_alpha = from->animation_state.to_alpha = 1.0f;
+	from->animation_state.from_x = from->swipe_offset;
+	from->animation_state.to_x = 0;
+	from->swipe_offset = 0;
+	add_animation(&from->animation_state.animation, slide_update, back_from_complete);
+
+	struct sway_workspace *peek = swipe.peek;
+	if (peek && workspace_alive(swipe.output, peek)) {
+		peek->animation_state.from_alpha = peek->animation_state.to_alpha = 1.0f;
+		peek->animation_state.from_x = peek->swipe_offset;
+		peek->animation_state.to_x = peek->swipe_offset > 0 ? swipe.span : -swipe.span;
+		peek->swipe_offset = 0;
+		add_animation(&peek->animation_state.animation, slide_update, back_peek_complete);
+	}
+}
+
+bool workspace_swipe_end(struct sway_seat *seat, bool cancelled) {
+	switch (swipe.state) {
+	case SWIPE_IDLE:
+		return false;
+	case SWIPE_DECIDING:
+	case SWIPE_IGNORED:
+		swipe.state = SWIPE_IDLE;
+		return true;
+	case SWIPE_ACTIVE:
+		break;
+	}
+	swipe.state = SWIPE_IDLE;
+	if (!workspace_alive(swipe.output, swipe.from)) {
+		return true;
+	}
+	if (swipe.peek && !workspace_alive(swipe.output, swipe.peek)) {
+		swipe.peek = NULL;
+	}
+
+	double offset = swipe.from->swipe_offset;
+	double speed = swipe.velocity * (config->workspace_swipe_invert ? -1.0 : 1.0);
+	bool far_enough = fabs(offset) > swipe.span * COMMIT_FRACTION;
+	bool flicked = fabs(speed) > FLICK_SPEED && (speed > 0) == (offset > 0);
+
+	if (!cancelled && swipe.peek && (far_enough || flicked)) {
+		// The switch's own slide (arrange_output) carries both on from
+		// where the fingers left them. Where there will be no slide —
+		// animations off, fading set instead, a fullscreen window on
+		// either — they are simply put back first.
+		if (!config->animation_duration_ms
+				|| config->workspace_animation != WORKSPACE_ANIMATION_SLIDE
+				|| swipe.from->current.fullscreen || swipe.peek->current.fullscreen) {
+			swipe.from->swipe_offset = swipe.peek->swipe_offset = 0;
+			swipe.peek->swipe_peek = false;
+		}
+		workspace_switch(swipe.peek);
+	} else {
+		slide_back();
+	}
+	swipe.from = swipe.peek = NULL;
+	return true;
+}
+
+// debug_workspace_swipe begin <fingers> | update <dx> [<dy>] | end | cancel
+//
+// Drives the swipe above as a touchpad would, for testing on machines (and
+// in sessions) without one. Vertical hand-over is not replayed.
+struct cmd_results *cmd_debug_workspace_swipe(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "debug_workspace_swipe", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+	struct sway_seat *seat = input_manager_current_seat();
+	static uint32_t clock_ms = 0;
+	clock_ms += 16;   // a touchpad event per frame, more or less
+	if (strcmp(argv[0], "begin") == 0 && argc >= 2) {
+		if (!workspace_swipe_begin(seat, (uint32_t)atoi(argv[1]))) {
+			return cmd_results_new(CMD_FAILURE, "workspace_swipe is off or uses other fingers");
+		}
+	} else if (strcmp(argv[0], "update") == 0 && argc >= 2) {
+		uint32_t fingers;
+		double ax, ay;
+		workspace_swipe_update(seat, atof(argv[1]), argc >= 3 ? atof(argv[2]) : 0.0,
+			clock_ms, &fingers, &ax, &ay);
+	} else if (strcmp(argv[0], "end") == 0) {
+		workspace_swipe_end(seat, false);
+	} else if (strcmp(argv[0], "cancel") == 0) {
+		workspace_swipe_end(seat, true);
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'debug_workspace_swipe begin <fingers>|update <dx> [<dy>]|end|cancel'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
