+static void handle_swipe_begin(struct sway_seat *seat,
+		struct wlr_pointer_swipe_begin_event *event) {
+	// b1air: workspaces that follow the fingers take their swipes first.
+	if (workspace_swipe_begin(seat, event->fingers)) {
+		return;
+	}
+	begin_regular_swipe(seat, event->pointer, event->time_msec, event->fingers);
+}
+
 static void handle_swipe_update(struct sway_seat *seat,
 		struct wlr_pointer_swipe_update_event *event) {
+	// b1air: a workspace swipe, or one that turned out vertical and goes
+	// on as a usual swipe from what has moved so far.
+	uint32_t fingers;
+	double acc_dx, acc_dy;
+	switch (workspace_swipe_update(seat, event->dx, event->dy, event->time_msec,
+			&fingers, &acc_dx, &acc_dy)) {
+	case WORKSPACE_SWIPE_CONSUMED:
+		return;
+	case WORKSPACE_SWIPE_HANDOVER:
+		begin_regular_swipe(seat, event->pointer, event->time_msec, fingers);
+		event->dx = acc_dx;
+		event->dy = acc_dy;
+		break;
+	case WORKSPACE_SWIPE_NOT_OURS:
+		break;
+	}
 
 	// Update any ongoing tracking ...
 	struct seatop_default_event *seatop = seat->seatop_data;
@@ -1074,6 +1099,9 @@ static void handle_swipe_update(struct sway_seat *seat,
 
