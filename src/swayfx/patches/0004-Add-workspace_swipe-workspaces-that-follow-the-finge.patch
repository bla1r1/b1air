+#ifndef _SWAY_DESKTOP_WORKSPACE_SWIPE_H
+#define _SWAY_DESKTOP_WORKSPACE_SWIPE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct sway_seat;
+
+// b1air: workspaces that follow the fingers on a touchpad swipe.
+//
+// With `workspace_swipe <fingers>` set, a horizontal swipe with that many
+// fingers moves the active workspace with the fingers and brings its
+// neighbour in beside it; on release it either switches to the neighbour or
+// slides back. A vertical swipe with the same fingers is handed back to the
+// usual gesture bindings.
+
+enum workspace_swipe_result {
+	WORKSPACE_SWIPE_NOT_OURS,   // not a workspace swipe: handle as usual
+	WORKSPACE_SWIPE_CONSUMED,   // taken
+	WORKSPACE_SWIPE_HANDOVER,   // turned out vertical: begin the usual handling
+};
+
+// True when this swipe is ours from the start (the finger count matches).
+bool workspace_swipe_begin(struct sway_seat *seat, uint32_t fingers);
+
+// On HANDOVER, *fingers, *dx and *dy say what to replay into the usual
+// handling: the swipe so far.
+enum workspace_swipe_result workspace_swipe_update(struct sway_seat *seat,
+	double dx, double dy, uint32_t time_msec,
+	uint32_t *fingers, double *acc_dx, double *acc_dy);
+
+// True when the swipe was ours.
+bool workspace_swipe_end(struct sway_seat *seat, bool cancelled);
+
+#endif
