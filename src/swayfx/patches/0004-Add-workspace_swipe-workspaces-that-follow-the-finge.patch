+++ b/sway/commands/workspace_swipe.c
@@ -0,0 +1,29 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+// workspace_swipe off|<fingers> [invert]
+//
+// A horizontal touchpad swipe with that many fingers moves the workspace
+// with the fingers and brings its neighbour in beside it; letting go switches
+// to it or slides back. Content follows the fingers (moving right brings in
+// the workspace before); `invert` turns that round.
+struct cmd_results *cmd_workspace_swipe(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "workspace_swipe", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+	if (strcasecmp(argv[0], "off") == 0 || strcasecmp(argv[0], "disable") == 0) {
+		config->workspace_swipe_fingers = 0;
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	char *end;
+	long fingers = strtol(argv[0], &end, 10);
+	if (*end || fingers < 2 || fingers > 5) {
+		return cmd_results_new(CMD_INVALID, "Expected 'workspace_swipe off|<2-5 fingers> [invert]'");
+	}
+	config->workspace_swipe_fingers = (uint32_t)fingers;
+	config->workspace_swipe_invert = argc >= 2 && strcasecmp(argv[1], "invert") == 0;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
