+int workspace_slide_offset(struct sway_workspace *ws) {
+	if (ws->animation_state.animation.initialized
+			&& ws->animation_state.from_x != ws->animation_state.to_x) {
+		return (int)roundf(get_animated_value(ws->animation_state.from_x,
+			ws->animation_state.to_x, &ws->animation_state.animation));
+	}
+	return ws->swipe_offset;
+}
+
+void workspace_place(struct sway_workspace *ws) {
+	if (!ws || !ws->output) {
+		return;
+	}
+	struct wlr_box *area = &ws->output->usable_area;
+	struct side_gaps *gaps = &ws->current_gaps;
+	int offset = workspace_slide_offset(ws);
+	wlr_scene_node_set_position(&ws->layers.tiling->node,
+		gaps->left + area->x + offset, gaps->top + area->y);
+	for (int i = 0; i < ws->current.floating->length; i++) {
+		struct sway_container *floater = ws->current.floating->items[i];
+		if (floater->current.fullscreen_mode != FULLSCREEN_NONE) {
+			continue;
+		}
+		wlr_scene_node_set_position(&floater->scene_tree->node,
+			floater->current.x + offset, floater->current.y);
+	}
+}
+
+static void workspace_slide_update_callback(void *data) {
+	workspace_place(data);
+}
+
 static void workspace_fade_complete_callback(void *data) {
 	struct sway_workspace *ws = data;
 	if (!ws || !ws->output) {
 		return;
 	}
+	ws->animation_state.from_x = ws->animation_state.to_x = 0;
 	struct sway_output *output = ws->output;
 	if (output->current.active_workspace == ws) {
 		return;
@@ -857,6 +891,31 @@ static void arrange_workspace_floating(struct sway_workspace *ws) {
 	}
 }
 
+// b1air: is this workspace sliding, or held aside by a swipe?
+static bool workspace_is_sliding(struct sway_workspace *ws) {
+	return ws->animation_state.from_x != ws->animation_state.to_x
+		|| ws->swipe_peek || ws->swipe_offset != 0;
+}
+
+// b1air: the floating windows of a sliding workspace, placed without the
+// per-window move animation: that animation sets each window's position on
+// every frame and would pull it back against the slide.
+static void arrange_workspace_floating_still(struct sway_workspace *ws) {
+	for (int i = 0; i < ws->current.floating->length; i++) {
+		struct sway_container *floater = ws->current.floating->items[i];
+		if (floater->current.fullscreen_mode != FULLSCREEN_NONE) {
+			continue;
+		}
+		finish_animation(&floater->animation_state.animation);
+		wlr_scene_node_reparent(&floater->scene_tree->node, root->layers.floating);
+		wlr_scene_node_set_enabled(&floater->scene_tree->node, true);
+		wlr_scene_node_set_enabled(&floater->shadow->node, container_has_shadow(floater) && floater->view);
+		wlr_scene_node_set_enabled(&floater->border.tree->node, true);
+		_arrange_container(floater, floater->current.width, floater->current.height,
+			floater->current.x, floater->current.y, true, ws->gaps_inner);
+	}
+}
+
 static void arrange_workspace_tiling(struct sway_workspace *ws,
 		int width, int height) {
 	arrange_children(ws->current.layout, ws->current.tiling,
@@ -883,6 +942,62 @@ static void disable_workspace(struct sway_workspace *ws) {
 	}
 }
 
+static int workspace_index_on(struct sway_output *output, struct sway_workspace *ws) {
+	for (int i = 0; i < output->current.workspaces->length; i++) {
+		if (output->current.workspaces->items[i] == ws) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+static void workspace_slide_complete_callback(void *data) {
+	struct sway_workspace *ws = data;
+	ws->animation_state.from_x = ws->animation_state.to_x = 0;
+	workspace_place(ws);
+}
+
+// Both workspaces slide: the old one out to one side, the new one in from
+// the other. Each starts from wherever it is drawn now — mid-slide, or held
+// by a swipe — so a switch never jumps.
+static void start_workspace_slide(struct sway_output *output,
+		struct sway_workspace *old_active, struct sway_workspace *new_active) {
+	int span = output->usable_area.width > 0 ? output->usable_area.width : output->width;
+	int dir = workspace_index_on(output, new_active) >= workspace_index_on(output, old_active) ? 1 : -1;
+	// A swipe already holding the new one beside the old knows its side.
+	if (new_active->swipe_peek && new_active->swipe_offset != 0) {
+		dir = new_active->swipe_offset > 0 ? 1 : -1;
+	}
+	float old_from = workspace_slide_offset(old_active);
+	float new_from = new_active->swipe_peek
+		? workspace_slide_offset(new_active) : old_from + dir * span;
+
+	old_active->swipe_offset = new_active->swipe_offset = 0;
+	old_active->swipe_peek = new_active->swipe_peek = false;
+
+	// An empty workspace is destroyed as it is left: nothing to slide out
+	// (swayfx's fade skips it the same way).
+	bool old_empty = old_active->current.tiling->length == 0
+		&& old_active->current.floating->length == 0;
+	if (!old_empty) {
+		old_active->animation_state.from_alpha = old_active->animation_state.to_alpha = 1.0f;
+		old_active->animation_state.from_x = old_from;
+		old_active->animation_state.to_x = -dir * span;
+	}
+
+	finish_animation(&new_active->animation_state.animation);
+	new_active->animation_state.from_alpha = new_active->animation_state.to_alpha = 1.0f;
+	new_active->animation_state.from_x = new_from;
+	new_active->animation_state.to_x = 0;
+
+	if (!old_empty) {
+		add_animation(&old_active->animation_state.animation,
+			workspace_slide_update_callback, workspace_fade_complete_callback);
+	}
+	add_animation(&new_active->animation_state.animation,
+		workspace_slide_update_callback, workspace_slide_complete_callback);
+}
+
 static void arrange_output(struct sway_output *output, int width, int height) {
 	struct sway_workspace *new_active = output->current.active_workspace;
 	struct sway_workspace *old_active = output->prev_active_workspace;
@@ -891,7 +1006,11 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		&& output->wlr_output->enabled && config->animation_duration_ms > 0 &&
 		!(old_active->current.fullscreen || new_active->current.fullscreen);
 
-	if (is_ws_switch) {
+	if (is_ws_switch && config->workspace_animation == WORKSPACE_ANIMATION_SLIDE) {
+		start_workspace_slide(output, old_active, new_active);
+	} else if (is_ws_switch) {
+		old_active->animation_state.from_x = old_active->animation_state.to_x = 0;
+		new_active->animation_state.from_x = new_active->animation_state.to_x = 0;
 		new_active->animation_state.from_alpha = 0.0f;
 
 		if (old_active->current.tiling->length == 0
@@ -921,7 +1040,9 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 		struct sway_workspace *child = output->current.workspaces->items[i];
 
 		bool activated = output->current.active_workspace == child && output->wlr_output->enabled;
-		bool animating = child->animation_state.animation.initialized;
+		// b1air: a workspace held beside the active one by a swipe is shown
+		// the way one sliding or fading out is.
+		bool animating = child->animation_state.animation.initialized || child->swipe_peek;
 
 		wlr_scene_node_reparent(&child->layers.tiling->node, output->layers.tiling);
 		wlr_scene_node_reparent(&child->layers.fullscreen->node, output->layers.fullscreen);
@@ -960,7 +1081,12 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 				arrange_workspace_tiling(child,
 					area->width - gaps->left - gaps->right,
 					area->height - gaps->top - gaps->bottom);
-				arrange_workspace_floating(child);
+				if (workspace_is_sliding(child)) {
+					arrange_workspace_floating_still(child);
+				} else {
+					arrange_workspace_floating(child);
+				}
+				workspace_place(child);
 			}
 		} else if (animating && !activated) {
 			// Workspace fading out - keep visible, alpha handled by render path
@@ -976,6 +1102,11 @@ static void arrange_output(struct sway_output *output, int width, int height) {
 			arrange_workspace_tiling(child,
 				area->width - gaps->left - gaps->right,
 				area->height - gaps->top - gaps->bottom);
+			// b1air: its floating windows go with it while it slides
+			if (workspace_is_sliding(child)) {
+				arrange_workspace_floating_still(child);
+			}
+			workspace_place(child);
 		} else {
 			wlr_scene_node_set_enabled(&child->layers.tiling->node, false);
 			wlr_scene_node_set_enabled(&child->layers.fullscreen->node, false);
