diff --git a/sway/commands/workspace_animation.c b/sway/commands/workspace_animation.c
new file mode 100644
index 00000000..df47cde2
--- /dev/null
+++ b/sway/commands/workspace_animation.c
@@ -0,0 +1,23 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+// workspace_animation fade|slide
+//
+// How switching workspaces is animated (when animation_duration_ms is set):
+// the old one fading into the new, or both sliding sideways, the new one in
+// from the side it lies on, as Hyprland and GNOME do.
+struct cmd_results *cmd_workspace_animation(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "workspace_animation", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	if (strcasecmp(argv[0], "fade") == 0) {
+		config->workspace_animation = WORKSPACE_ANIMATION_FADE;
+	} else if (strcasecmp(argv[0], "slide") == 0) {
+		config->workspace_animation = WORKSPACE_ANIMATION_SLIDE;
+	} else {
+		return cmd_results_new(CMD_INVALID, "Expected 'workspace_animation fade|slide'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
