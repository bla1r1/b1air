+// b1air: where a window comes from as it opens, and goes as it closes, for
+// window_animation; the box in the coordinates of its parent, like x and y.
+static void window_anim_away(struct sway_container *con,
+		float x, float y, float w, float h,
+		int *ax, int *ay, int *aw, int *ah) {
+	*ax = x; *ay = y; *aw = w; *ah = h;
+	switch (config->window_animation) {
+	case WINDOW_ANIMATION_POPIN:;
+		float f = config->window_popin_factor;
+		*ax = x + w * (1.0f - f) / 2.0f;
+		*ay = y + h * (1.0f - f) / 2.0f;
+		*aw = w * f;
+		*ah = h * f;
+		break;
+	case WINDOW_ANIMATION_SLIDE:;
+		// Beyond the nearest edge of its workspace, worked out in layout
+		// coordinates (a window inside a split is placed relative to it).
+		struct sway_workspace *ws = con->current.workspace
+			? con->current.workspace : con->pending.workspace;
+		struct wlr_scene_tree *parent = con->scene_tree->node.parent;
+		if (!ws || !parent) {
+			break;
+		}
+		int px, py;
+		wlr_scene_node_coords(&parent->node, &px, &py);
+		float cx = px + x + w / 2.0f, cy = py + y + h / 2.0f;
+		float left = cx - ws->x, right = ws->x + ws->width - cx;
+		float top = cy - ws->y, bottom = ws->y + ws->height - cy;
+		float nearest = fminf(fminf(left, right), fminf(top, bottom));
+		if (nearest == left) {
+			*ax = ws->x - w - px;
+		} else if (nearest == right) {
+			*ax = ws->x + ws->width - px;
+		} else if (nearest == top) {
+			*ay = ws->y - h - py;
+		} else {
+			*ay = ws->y + ws->height - py;
+		}
+		break;
+	case WINDOW_ANIMATION_FADE:
+	case WINDOW_ANIMATION_NONE:
+		break;
+	}
+}
