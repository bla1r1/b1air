@@ -0,0 +1,48 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+// window_animation popin [<percent>]|fade|slide|none
+//
+// How windows open and close (when animation_duration_ms is set), the
+// styles of Hyprland's `animation = windows`:
+//   popin  grow from the middle while fading in, from <percent> of the
+//          final size (default 80); shrink the same way on closing
+//   fade   fade in and out in place
+//   slide  come in from the nearest edge of the workspace, and leave by it
+//   none   appear and vanish at once; moves and resizes still animate
+struct cmd_results *cmd_window_animation(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "window_animation", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+	const char *usage = "Expected 'window_animation popin [<percent>]|fade|slide|none'";
+	if (strcasecmp(argv[0], "popin") == 0) {
+		float factor = 0.8f;
+		if (argc >= 2) {
+			char *end;
+			long percent = strtol(argv[1], &end, 10);
+			if (*end == '%') {
+				end++;
+			}
+			if (*end || percent < 0 || percent > 100) {
+				return cmd_results_new(CMD_INVALID, "%s", usage);
+			}
+			factor = percent / 100.0f;
+		}
+		config->window_animation = WINDOW_ANIMATION_POPIN;
+		config->window_popin_factor = factor;
+	} else if (argc > 1) {
+		return cmd_results_new(CMD_INVALID, "%s", usage);
+	} else if (strcasecmp(argv[0], "fade") == 0) {
+		config->window_animation = WINDOW_ANIMATION_FADE;
+	} else if (strcasecmp(argv[0], "slide") == 0) {
+		config->window_animation = WINDOW_ANIMATION_SLIDE;
+	} else if (strcasecmp(argv[0], "none") == 0) {
+		config->window_animation = WINDOW_ANIMATION_NONE;
+	} else {
+		return cmd_results_new(CMD_INVALID, "%s", usage);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
