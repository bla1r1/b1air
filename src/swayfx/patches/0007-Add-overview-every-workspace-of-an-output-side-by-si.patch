--- /dev/null
+++ b/sway/commands/overview_swipe.c
@@ -0,0 +1,27 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+// overview_swipe off|<fingers>
+//
+// A swipe up with that many fingers brings the workspace overview in with
+// the fingers, a swipe down takes it away (sway/desktop/overview.c).
+// Sideways swipes with them still go to the gesture bindings.
+struct cmd_results *cmd_overview_swipe(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "overview_swipe", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	if (strcasecmp(argv[0], "off") == 0 || strcasecmp(argv[0], "disable") == 0) {
+		config->overview_swipe_fingers = 0;
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	char *end;
+	long fingers = strtol(argv[0], &end, 10);
+	if (*end || fingers < 3 || fingers > 5) {
+		return cmd_results_new(CMD_INVALID, "Expected 'overview_swipe off|<3-5 fingers>'");
+	}
+	config->overview_swipe_fingers = (uint32_t)fingers;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
