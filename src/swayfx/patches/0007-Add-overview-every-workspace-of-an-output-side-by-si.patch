diff --git a/sway/desktop/overview.c b/sway/desktop/overview.c
new file mode 100644
index 00000000..21b9268a
--- /dev/null
+++ b/sway/desktop/overview.c
@@ -0,0 +1,506 @@
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xkbcommon/xkbcommon.h>
+#include <scenefx/types/wlr_scene.h>
+#include "sway/animation_manager.h"
+#include "sway/commands.h"
+#include "sway/input/input-manager.h"
+#include "sway/config.h"
+#include "sway/desktop/overview.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/root.h"
+#include "sway/tree/workspace.h"
+#include "list.h"
+#include "log.h"
+
+// b1air: every workspace of one output side by side, live and scaled down,
+// to see what is where and go to it (overview toggle|show|hide). Each
+// workspace is its own tiling tree drawn at a scale (scenefx's
+// wlr_scene_tree_set_scale), so windows keep their size and keep drawing.
+// The active workspace shrinks from the full screen into its place, over
+// the others fading in in theirs. A click, or Enter on the one picked with the
+// arrows, goes there; Escape leaves.
+//
+// Floating windows live in one layer shared by all workspaces, not in a
+// workspace's tree, so they cannot be shown in place: they are hidden for
+// the overview. The special workspace is not shown either.
+
+#define OVERVIEW_GAP 24
+
+static struct {
+	struct sway_output *output;   // NULL when no overview
+	bool closing;
+	float t;                      // 0 the usual view, 1 the overview
+	float from_t, to_t;           // what the animation runs between
+	struct animation anim;
+	bool anim_ready;
+	int selected;                 // index in the shown workspaces
+	struct wlr_scene_tree *decor; // the cards behind the workspaces
+} ov;
+
+static list_t *shown_workspaces(struct sway_output *output) {
+	list_t *list = create_list();
+	for (int i = 0; i < output->workspaces->length; i++) {
+		struct sway_workspace *ws = output->workspaces->items[i];
+		if (!workspace_is_special(ws)) {
+			list_add(list, ws);
+		}
+	}
+	return list;
+}
+
+// Where workspace i of n goes, in output coordinates, and at what scale.
+static void overview_cell(struct sway_output *output, int i, int n,
+		struct wlr_box *cell, float *scale) {
+	struct wlr_box *area = &output->usable_area;
+	int cols = n <= 3 ? n : (int)ceil(sqrt((double)n));
+	int rows = (n + cols - 1) / cols;
+	double margin = 0.06 * fmin(area->width, area->height);
+	double cw = (area->width - 2 * margin - (cols - 1) * OVERVIEW_GAP) / cols;
+	double ch = (area->height - 2 * margin - (rows - 1) * OVERVIEW_GAP) / rows;
+	double s = fmin(cw / area->width, ch / area->height);
+	double w = area->width * s, h = area->height * s;
+
+	int row = i / cols, col = i % cols;
+	int in_row = row == rows - 1 ? n - row * cols : cols;
+	double row_w = in_row * w + (in_row - 1) * OVERVIEW_GAP;
+	double all_h = rows * h + (rows - 1) * OVERVIEW_GAP;
+	cell->x = (int)lround(area->x + (area->width - row_w) / 2 + col * (w + OVERVIEW_GAP));
+	cell->y = (int)lround(area->y + (area->height - all_h) / 2 + row * (h + OVERVIEW_GAP));
+	cell->width = (int)lround(w);
+	cell->height = (int)lround(h);
+	*scale = (float)s;
+}
+
+static float lerp(float a, float b, float t) {
+	return a + (b - a) * t;
+}
+
+static void add_rect(struct wlr_scene_tree *parent, int x, int y, int w, int h,
+		const float color[4]) {
+	struct wlr_scene_rect *rect = wlr_scene_rect_create(parent, w, h, color);
+	if (rect) {
+		wlr_scene_node_set_position(&rect->node, x, y);
+	}
+}
+
+// Puts every shown workspace where `ov.t` says, and the cards under them.
+static void overview_place(void) {
+	struct sway_output *output = ov.output;
+	if (!output) {
+		return;
+	}
+	struct sway_workspace *active = output->current.active_workspace;
+	struct wlr_box *area = &output->usable_area;
+	list_t *list = shown_workspaces(output);
+	int n = list->length;
+	if (ov.selected >= n) {
+		ov.selected = n > 0 ? n - 1 : 0;
+	}
+
+	if (ov.decor) {
+		wlr_scene_node_destroy(&ov.decor->node);
+	}
+	ov.decor = wlr_scene_tree_create(output->layers.tiling);
+	wlr_scene_node_lower_to_bottom(&ov.decor->node);
+
+	for (int i = 0; i < n; i++) {
+		struct sway_workspace *ws = list->items[i];
+		struct wlr_box cell;
+		float s;
+		overview_cell(output, i, n, &cell, &s);
+
+		// The active one comes from the full screen; the others are only
+		// ever in their place, and come in with the cards.
+		float t = ws == active ? ov.t : 1.0f;
+		float scale = lerp(1.0f, s, t);
+		float x = lerp(area->x, cell.x, t), y = lerp(area->y, cell.y, t);
+		struct side_gaps *gaps = &ws->current_gaps;
+
+		bool show = ws == active || ov.t > 0.0f;
+		wlr_scene_node_set_enabled(&ws->layers.tiling->node, show);
+		wlr_scene_node_set_enabled(&ws->layers.fullscreen->node, false);
+		wlr_scene_tree_set_scale(ws->layers.tiling, scale);
+		wlr_scene_node_set_position(&ws->layers.tiling->node,
+			(int)lround(x + gaps->left * scale), (int)lround(y + gaps->top * scale));
+
+		// The others fade in with the cards, under the active one.
+		ws->animation_state.from_alpha = ws->animation_state.to_alpha =
+			ws == active ? 1.0f : ov.t;
+
+		const float card[4] = {0.0f, 0.0f, 0.0f, 0.35f * ov.t};
+		add_rect(ov.decor, cell.x, cell.y, cell.width, cell.height, card);
+		if (i == ov.selected) {
+			const float edge[4] = {0.55f * ov.t, 0.65f * ov.t, 1.0f * ov.t, ov.t};
+			const int b = 3;
+			add_rect(ov.decor, cell.x - b, cell.y - b, cell.width + 2 * b, b, edge);
+			add_rect(ov.decor, cell.x - b, cell.y + cell.height, cell.width + 2 * b, b, edge);
+			add_rect(ov.decor, cell.x - b, cell.y, b, cell.height, edge);
+			add_rect(ov.decor, cell.x + cell.width, cell.y, b, cell.height, edge);
+		}
+	}
+	list_free(list);
+	if (active) {
+		wlr_scene_node_raise_to_top(&active->layers.tiling->node);
+	}
+
+	wlr_scene_node_set_enabled(&root->layers.floating->node, ov.t <= 0.0f);
+}
+
+static void overview_finish_hide(void) {
+	struct sway_output *output = ov.output;
+	if (!output) {
+		return;
+	}
+	for (int i = 0; i < output->workspaces->length; i++) {
+		struct sway_workspace *ws = output->workspaces->items[i];
+		wlr_scene_tree_set_scale(ws->layers.tiling, 1.0f);
+		ws->animation_state.from_alpha = ws->animation_state.to_alpha = 1.0f;
+	}
+	if (ov.decor) {
+		wlr_scene_node_destroy(&ov.decor->node);
+		ov.decor = NULL;
+	}
+	wlr_scene_node_set_enabled(&root->layers.floating->node, true);
+	ov.output = NULL;
+	ov.closing = false;
+	ov.t = 0.0f;
+	// The usual arrangement puts back what is shown, and where.
+	arrange_output(output);
+}
+
+static void overview_update(void *data) {
+	ov.t = lerp(ov.from_t, ov.to_t, ov.anim.multiplier);
+	overview_place();
+}
+
+static void overview_complete(void *data) {
+	if (ov.closing) {
+		overview_finish_hide();
+	} else {
+		ov.t = 1.0f;
+		overview_place();
+	}
+}
+
+// From where it is now to the overview (1) or away from it (0).
+static void overview_animate(void) {
+	ov.from_t = ov.t;
+	ov.to_t = ov.closing ? 0.0f : 1.0f;
+	if (!ov.anim_ready) {
+		ov.anim = init_animation(NULL);
+		ov.anim_ready = true;
+	}
+	if (!config->animation_duration_ms) {
+		overview_complete(NULL);
+		return;
+	}
+	add_animation(&ov.anim, overview_update, overview_complete);
+	// Nothing else may be running to start the clock (a transaction does).
+	start_animations();
+}
+
+bool overview_active_on(struct sway_output *output) {
+	return output && ov.output == output;
+}
+
+static void overview_begin(struct sway_output *output);
+
+void overview_show(struct sway_output *output) {
+	if (!output) {
+		return;
+	}
+	if (ov.output && ov.output != output) {
+		finish_animation(&ov.anim);
+		overview_finish_hide();
+	}
+	if (ov.output == output && !ov.closing) {
+		return;
+	}
+	if (ov.output == output) {
+		// Was leaving: turns round from where it is.
+		ov.closing = false;
+		overview_animate();
+		return;
+	}
+	overview_begin(output);
+	overview_animate();
+}
+
+// Takes the output over for the overview, still at t = 0.
+static void overview_begin(struct sway_output *output) {
+	// Workspaces still sliding or held by a swipe are put in place first.
+	for (int i = 0; i < output->workspaces->length; i++) {
+		struct sway_workspace *ws = output->workspaces->items[i];
+		finish_animation(&ws->animation_state.animation);
+		ws->animation_state.from_x = ws->animation_state.to_x = 0;
+		ws->swipe_offset = 0;
+		ws->swipe_peek = false;
+	}
+	ov.output = output;
+	ov.closing = false;
+	ov.selected = 0;
+	list_t *list = shown_workspaces(output);
+	for (int i = 0; i < list->length; i++) {
+		if (list->items[i] == output->current.active_workspace) {
+			ov.selected = i;
+		}
+	}
+	list_free(list);
+	ov.t = 0.0f;
+	overview_place();
+	// Lays the other workspaces out too (they are only arranged while
+	// shown); overview_rearranged() places them once that lands.
+	arrange_output(output);
+}
+
+void overview_hide(void) {
+	if (!ov.output || ov.closing) {
+		return;
+	}
+	ov.closing = true;
+	overview_animate();
+}
+
+void overview_rearranged(struct sway_output *output) {
+	if (overview_active_on(output)) {
+		overview_place();
+	}
+}
+
+static void overview_go(struct sway_workspace *ws) {
+	if (ws && ws != ov.output->current.active_workspace) {
+		workspace_switch(ws);
+	}
+	overview_hide();
+}
+
+bool overview_handle_button(double lx, double ly, bool pressed) {
+	if (!ov.output || ov.closing) {
+		return false;
+	}
+	if (!pressed) {
+		return true;
+	}
+	struct sway_output *output = ov.output;
+	double ox = lx - output->lx, oy = ly - output->ly;
+	list_t *list = shown_workspaces(output);
+	struct sway_workspace *picked = NULL;
+	for (int i = 0; i < list->length; i++) {
+		struct wlr_box cell;
+		float s;
+		overview_cell(output, i, list->length, &cell, &s);
+		if (wlr_box_contains_point(&cell, ox, oy)) {
+			picked = list->items[i];
+		}
+	}
+	list_free(list);
+	// A click beside every workspace just leaves.
+	overview_go(picked);
+	return true;
+}
+
+bool overview_handle_key(xkb_keysym_t sym) {
+	if (!ov.output || ov.closing) {
+		return false;
+	}
+	list_t *list = shown_workspaces(ov.output);
+	int n = list->length;
+	int cols = n <= 3 ? n : (int)ceil(sqrt((double)n));
+	bool handled = true;
+	switch (sym) {
+	case XKB_KEY_Escape:
+		overview_hide();
+		break;
+	case XKB_KEY_Return:
+	case XKB_KEY_KP_Enter:
+	case XKB_KEY_space:
+		overview_go(n > 0 ? list->items[ov.selected] : NULL);
+		break;
+	case XKB_KEY_Left:
+		if (ov.selected > 0) ov.selected--;
+		overview_place();
+		break;
+	case XKB_KEY_Right:
+		if (ov.selected < n - 1) ov.selected++;
+		overview_place();
+		break;
+	case XKB_KEY_Up:
+		if (ov.selected - cols >= 0) ov.selected -= cols;
+		overview_place();
+		break;
+	case XKB_KEY_Down:
+		if (ov.selected + cols < n) ov.selected += cols;
+		overview_place();
+		break;
+	default:
+		handled = false;
+	}
+	list_free(list);
+	return handled;
+}
+
+// ── The touchpad swipe ─────────────────────────────────────────────────────
+//
+// overview_swipe <fingers>: a swipe up with that many fingers brings the
+// overview in with the fingers, a swipe down takes it away the same way;
+// letting go finishes it, or puts it back if the fingers did not go far
+// (or fast) enough. A sideways swipe is handed back to the usual gesture
+// bindings.
+
+// Touchpad units before the swipe counts as up/down or sideways.
+#define SWIPE_DECIDE 12.0
+// Travel that takes the overview all the way in.
+#define SWIPE_DISTANCE 260.0
+// Past this much of the way, letting go finishes it.
+#define SWIPE_COMMIT 0.35
+// Or moving this fast (units per ms) the way it was going.
+#define SWIPE_FLICK 0.5
+
+static struct {
+	enum { OSWIPE_IDLE, OSWIPE_DECIDING, OSWIPE_ACTIVE, OSWIPE_IGNORED } state;
+	uint32_t fingers;
+	double dx, dy, velocity;
+	uint32_t last_time;
+	bool opening;
+} osw;
+
+static double swipe_progress(void) {
+	double p = (osw.opening ? -osw.dy : osw.dy) / SWIPE_DISTANCE;
+	return p < 0.0 ? 0.0 : (p > 1.0 ? 1.0 : p);
+}
+
+static void swipe_apply(void) {
+	double p = swipe_progress();
+	ov.t = (float)(osw.opening ? p : 1.0 - p);
+	overview_place();
+}
+
+bool overview_swipe_begin(struct sway_seat *seat, uint32_t fingers) {
+	if (!config->overview_swipe_fingers || fingers != config->overview_swipe_fingers) {
+		return false;
+	}
+	osw.state = OSWIPE_DECIDING;
+	osw.fingers = fingers;
+	osw.dx = osw.dy = osw.velocity = 0.0;
+	osw.last_time = 0;
+	return true;
+}
+
+enum overview_swipe_result overview_swipe_update(struct sway_seat *seat,
+		double dx, double dy, uint32_t time_msec,
+		uint32_t *fingers, double *acc_dx, double *acc_dy) {
+	switch (osw.state) {
+	case OSWIPE_IDLE:
+		return OVERVIEW_SWIPE_NOT_OURS;
+	case OSWIPE_IGNORED:
+		return OVERVIEW_SWIPE_CONSUMED;
+	case OSWIPE_DECIDING: {
+		osw.dx += dx;
+		osw.dy += dy;
+		if (hypot(osw.dx, osw.dy) < SWIPE_DECIDE) {
+			return OVERVIEW_SWIPE_CONSUMED;
+		}
+		struct sway_workspace *ws = seat_get_focused_workspace(seat);
+		struct sway_output *output = ws ? ws->output : NULL;
+		bool open = overview_active_on(output) && !ov.closing;
+		bool up = osw.dy < 0;
+		// Sideways, or a way that does nothing here (down with no
+		// overview): the usual bindings have it, from what moved so far.
+		if (!output || fabs(osw.dx) > fabs(osw.dy) || up == open
+				|| (ov.output && ov.output != output)) {
+			*fingers = osw.fingers;
+			*acc_dx = osw.dx;
+			*acc_dy = osw.dy;
+			osw.state = OSWIPE_IDLE;
+			return OVERVIEW_SWIPE_HANDOVER;
+		}
+		osw.opening = up;
+		finish_animation(&ov.anim);
+		if (osw.opening && !overview_active_on(output)) {
+			overview_begin(output);
+		}
+		ov.closing = false;
+		// The fingers start from where it is now, should it have been
+		// on its way somewhere.
+		osw.dy = osw.opening ? -ov.t * SWIPE_DISTANCE : (1.0 - ov.t) * SWIPE_DISTANCE;
+		osw.state = OSWIPE_ACTIVE;
+		osw.last_time = time_msec;
+		swipe_apply();
+		return OVERVIEW_SWIPE_CONSUMED;
+	}
+	case OSWIPE_ACTIVE:
+		if (!ov.output) {
+			osw.state = OSWIPE_IGNORED;
+			return OVERVIEW_SWIPE_CONSUMED;
+		}
+		osw.dy += dy;
+		if (time_msec > osw.last_time) {
+			double instant = dy / (double)(time_msec - osw.last_time);
+			osw.velocity = 0.6 * osw.velocity + 0.4 * instant;
+		}
+		osw.last_time = time_msec;
+		swipe_apply();
+		return OVERVIEW_SWIPE_CONSUMED;
+	}
+	return OVERVIEW_SWIPE_NOT_OURS;
+}
+
+bool overview_swipe_end(struct sway_seat *seat, bool cancelled) {
+	switch (osw.state) {
+	case OSWIPE_IDLE:
+		return false;
+	case OSWIPE_DECIDING:
+	case OSWIPE_IGNORED:
+		osw.state = OSWIPE_IDLE;
+		return true;
+	case OSWIPE_ACTIVE:
+		break;
+	}
+	osw.state = OSWIPE_IDLE;
+	if (!ov.output) {
+		return true;
+	}
+	double speed = osw.opening ? -osw.velocity : osw.velocity;
+	bool done = !cancelled && (swipe_progress() > SWIPE_COMMIT || speed > SWIPE_FLICK);
+	// Opening and done, or closing and not: the overview stays.
+	ov.closing = osw.opening != done;
+	overview_animate();
+	return true;
+}
+
+// debug_overview_swipe begin <fingers> | update <dy> [<dx>] | end | cancel
+//
+// Drives the swipe above as a touchpad would, for tests without one.
+struct cmd_results *cmd_debug_overview_swipe(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "debug_overview_swipe", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+	struct sway_seat *seat = input_manager_current_seat();
+	static uint32_t clock_ms = 0;
+	clock_ms += 16;
+	if (strcmp(argv[0], "begin") == 0 && argc >= 2) {
+		if (!overview_swipe_begin(seat, (uint32_t)atoi(argv[1]))) {
+			return cmd_results_new(CMD_FAILURE, "overview_swipe is off or uses other fingers");
+		}
+	} else if (strcmp(argv[0], "update") == 0 && argc >= 2) {
+		uint32_t fingers;
+		double ax, ay;
+		if (overview_swipe_update(seat, argc >= 3 ? atof(argv[2]) : 0.0, atof(argv[1]),
+				clock_ms, &fingers, &ax, &ay) == OVERVIEW_SWIPE_HANDOVER) {
+			return cmd_results_new(CMD_FAILURE, "handed over: not an overview swipe");
+		}
+	} else if (strcmp(argv[0], "end") == 0) {
+		overview_swipe_end(seat, false);
+	} else if (strcmp(argv[0], "cancel") == 0) {
+		overview_swipe_end(seat, true);
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'debug_overview_swipe begin <fingers>|update <dy> [<dx>]|end|cancel'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
