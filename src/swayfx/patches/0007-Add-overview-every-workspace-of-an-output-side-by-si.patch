new file mode 100644
index 00000000..30e960ac
--- /dev/null
+++ b/sway/commands/overview.c
@@ -0,0 +1,37 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/desktop/overview.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/workspace.h"
+
+// overview toggle|show|hide
+//
+// Every workspace of the focused output side by side, live, to go to one
+// with a click or the arrows and Enter; Escape leaves (sway/desktop/overview.c).
+struct cmd_results *cmd_overview(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "overview", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_seat *seat = config->handler_context.seat;
+	struct sway_workspace *ws = seat ? seat_get_focused_workspace(seat) : NULL;
+	struct sway_output *output = ws ? ws->output : NULL;
+	if (!output) {
+		return cmd_results_new(CMD_FAILURE, "No output to show an overview on");
+	}
+	if (strcasecmp(argv[0], "toggle") == 0) {
+		if (overview_active_on(output)) {
+			overview_hide();
+		} else {
+			overview_show(output);
+		}
+	} else if (strcasecmp(argv[0], "show") == 0) {
+		overview_show(output);
+	} else if (strcasecmp(argv[0], "hide") == 0) {
+		overview_hide();
+	} else {
+		return cmd_results_new(CMD_INVALID, "Expected 'overview toggle|show|hide'");
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
