diff --git a/include/sway/tree/snap.h b/include/sway/tree/snap.h
new file mode 100644
index 0000000..2d13902
--- /dev/null
+++ b/include/sway/tree/snap.h
@@ -0,0 +1,42 @@
+#ifndef _SWAY_SNAP_H
+#define _SWAY_SNAP_H
+#include <stdbool.h>
+#include <wlr/util/box.h>
+
+struct sway_container;
+struct sway_output;
+
+// b1air: where a floating window can be snapped to on its output. The halves
+// and quarters of the usable area (what bars and panels leave), or all of it.
+enum sway_snap_zone {
+	SNAP_NONE,
+	SNAP_LEFT, SNAP_RIGHT, SNAP_TOP, SNAP_BOTTOM,
+	SNAP_TOP_LEFT, SNAP_TOP_RIGHT, SNAP_BOTTOM_LEFT, SNAP_BOTTOM_RIGHT,
+	SNAP_MAXIMIZE,
+};
+
+enum sway_snap_zone snap_zone_parse(const char *name);
+const char *snap_zone_name(enum sway_snap_zone zone);
+
+// The zone the cursor at lx, ly asks for while a floating window is dragged:
+// near the left or right edge a half, or a quarter near the top or bottom of
+// that edge; near the top edge all of it. SNAP_NONE elsewhere, or when
+// floating_snap is off. `output` is set to the output it is on.
+enum sway_snap_zone snap_zone_at(double lx, double ly,
+		struct sway_output **output);
+
+// The zone's box on the output, in layout coordinates: where a tiled window
+// would be, with the workspace's gaps round it and between the halves.
+bool snap_zone_box(struct sway_output *output, enum sway_snap_zone zone,
+		struct wlr_box *box);
+
+// Snap a floating container to the zone of the output: the size it had is
+// kept, for when it is unsnapped. Not arranged or committed.
+void container_snap(struct sway_container *con, struct sway_output *output,
+		enum sway_snap_zone zone);
+
+// Give a snapped container its size from before back, its top left at lx, ly.
+// Nothing when it is not snapped. Not arranged or committed.
+void container_unsnap(struct sway_container *con, double lx, double ly);
+
+#endif
