@@ -1,19 +1,89 @@
+#include <math.h>
 #include <wlr/types/wlr_cursor.h>
 #include "sway/desktop/transaction.h"
 #include "sway/input/cursor.h"
 #include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/snap.h"
+
+// b1air: how far the cursor goes before a snapped window being dragged is
+// given its size back, so that a click on its title bar leaves it snapped.
+#define UNSNAP_THRESHOLD 8
 
 struct seatop_move_floating_event {
 	struct sway_container *con;
 	double dx, dy; // cursor offset in container
+	double ref_lx, ref_ly; // where the drag began
+	// b1air: the zone the cursor is in, and its preview
+	enum sway_snap_zone zone;
+	struct sway_output *zone_output;
+	struct wlr_scene_rect *preview_rect;
+	struct wlr_scene_blur *preview_blur;
 };
 
+static void destroy_preview(struct seatop_move_floating_event *e) {
+	if (e->preview_rect) {
+		wlr_scene_node_destroy(&e->preview_rect->node);
+		e->preview_rect = NULL;
+	}
+	if (e->preview_blur) {
+		wlr_scene_node_destroy(&e->preview_blur->node);
+		e->preview_blur = NULL;
+	}
+}
+
+static void update_preview(struct sway_seat *seat,
+		struct seatop_move_floating_event *e) {
+	struct wlr_box box;
+	if (!snap_zone_box(e->zone_output, e->zone, &box)) {
+		if (e->preview_rect) {
+			wlr_scene_node_set_enabled(&e->preview_rect->node, false);
+			wlr_scene_node_set_enabled(&e->preview_blur->node, false);
+		}
+		return;
+	}
+	if (!e->preview_rect) {
+		// As the drop indicator of a tiling drag: the focused indicator
+		// colour at half strength, over a blur.
+		const float *indicator = config->border_colors.focused.indicator;
+		float color[4] = {
+			indicator[0] * .5, indicator[1] * .5,
+			indicator[2] * .5, indicator[3] * .5,
+		};
+		e->preview_blur = wlr_scene_blur_create(seat->scene_tree, 0, 0);
+		if (!e->preview_blur) {
+			return;
+		}
+		e->preview_rect = wlr_scene_rect_create(seat->scene_tree, 0, 0, color);
+		if (!e->preview_rect) {
+			wlr_scene_node_destroy(&e->preview_blur->node);
+			e->preview_blur = NULL;
+			return;
+		}
+	}
+	int radius = MIN(config->corner_radius, MIN(box.width / 2, box.height / 2));
+	wlr_scene_node_set_enabled(&e->preview_rect->node, true);
+	wlr_scene_node_set_enabled(&e->preview_blur->node, true);
+	wlr_scene_node_set_position(&e->preview_rect->node, box.x, box.y);
+	wlr_scene_node_set_position(&e->preview_blur->node, box.x, box.y);
+	wlr_scene_rect_set_size(e->preview_rect, box.width, box.height);
+	wlr_scene_blur_set_size(e->preview_blur, box.width, box.height);
+	wlr_scene_rect_set_corner_radii(e->preview_rect, corner_radii_all(radius));
+	wlr_scene_blur_set_corner_radii(e->preview_blur, corner_radii_all(radius));
+}
+
 static void finalize_move(struct sway_seat *seat) {
 	struct seatop_move_floating_event *e = seat->seatop_data;
 
-	// We "move" the container to its own location
-	// so it discovers its output again.
-	container_floating_move_to(e->con, e->con->pending.x, e->con->pending.y);
+	if (e->zone != SNAP_NONE) {
+		container_snap(e->con, e->zone_output, e->zone);
+		arrange_container(e->con);
+	} else {
+		// We "move" the container to its own location
+		// so it discovers its output again.
+		container_floating_move_to(e->con, e->con->pending.x, e->con->pending.y);
+	}
 	transaction_commit_dirty();
 
 	e->con->animation_state.seat_is_moving_float = false;
@@ -42,7 +112,25 @@ static void handle_pointer_motion(struct sway_seat *seat, uint32_t time_msec) {
 
 	e->con->animation_state.seat_is_moving_float = true;
 
+	// A snapped window dragged away gets its own size back, under the
+	// cursor where it was along the width: the title bar stays in hand.
+	if (e->con->snap_zone != SNAP_NONE &&
+			hypot(cursor->x - e->ref_lx, cursor->y - e->ref_ly) > UNSNAP_THRESHOLD) {
+		double share = e->con->pending.width > 0 ?
+			e->dx / e->con->pending.width : 0.5;
+		e->dx = share * e->con->snap_restore_width;
+		e->dy = MIN(e->dy, e->con->snap_restore_height / 2);
+		container_unsnap(e->con, cursor->x - e->dx, cursor->y - e->dy);
+		arrange_container(e->con);
+	}
+
 	container_floating_move_to(e->con, cursor->x - e->dx, cursor->y - e->dy);
+
+	enum sway_snap_zone zone = snap_zone_at(cursor->x, cursor->y, &e->zone_output);
+	if (zone != e->zone) {
+		e->zone = zone;
+		update_preview(seat, e);
+	}
 	transaction_commit_dirty();
 }
 
@@ -53,11 +141,16 @@ static void handle_unref(struct sway_seat *seat, struct sway_container *con) {
 	}
 }
 
+static void handle_end(struct sway_seat *seat) {
+	destroy_preview(seat->seatop_data);
+}
+
 static const struct sway_seatop_impl seatop_impl = {
 	.button = handle_button,
 	.pointer_motion = handle_pointer_motion,
 	.tablet_tool_tip = handle_tablet_tool_tip,
 	.unref = handle_unref,
+	.end = handle_end,
 };
 
 void seatop_begin_move_floating(struct sway_seat *seat,
@@ -73,6 +166,8 @@ void seatop_begin_move_floating(struct sway_seat *seat,
 	e->con = con;
 	e->dx = cursor->cursor->x - con->pending.x;
 	e->dy = cursor->cursor->y - con->pending.y;
+	e->ref_lx = cursor->cursor->x;
+	e->ref_ly = cursor->cursor->y;
 
 	con->animation_state.seat_is_moving_float = true;
 
