diff --git a/sway/tree/snap.c b/sway/tree/snap.c
new file mode 100644
index 0000000..796d5cb
--- /dev/null
+++ b/sway/tree/snap.c
@@ -0,0 +1,162 @@
+#include <math.h>
+#include <string.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "sway/config.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "sway/tree/root.h"
+#include "sway/tree/snap.h"
+#include "sway/tree/workspace.h"
+
+static const char *zone_names[] = {
+	[SNAP_NONE] = "none",
+	[SNAP_LEFT] = "left",
+	[SNAP_RIGHT] = "right",
+	[SNAP_TOP] = "top",
+	[SNAP_BOTTOM] = "bottom",
+	[SNAP_TOP_LEFT] = "top-left",
+	[SNAP_TOP_RIGHT] = "top-right",
+	[SNAP_BOTTOM_LEFT] = "bottom-left",
+	[SNAP_BOTTOM_RIGHT] = "bottom-right",
+	[SNAP_MAXIMIZE] = "maximize",
+};
+
+enum sway_snap_zone snap_zone_parse(const char *name) {
+	for (size_t i = SNAP_LEFT; i < sizeof(zone_names) / sizeof(*zone_names); i++) {
+		if (strcmp(name, zone_names[i]) == 0) {
+			return i;
+		}
+	}
+	return SNAP_NONE;
+}
+
+const char *snap_zone_name(enum sway_snap_zone zone) {
+	return zone_names[zone];
+}
+
+// How far down from the top, or up from the bottom, of a side edge a quarter
+// is asked for rather than a half: a sixth of the output's height.
+#define SNAP_CORNER_SHARE 6
+
+enum sway_snap_zone snap_zone_at(double lx, double ly,
+		struct sway_output **output) {
+	*output = NULL;
+	if (config->floating_snap <= 0) {
+		return SNAP_NONE;
+	}
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, lx, ly);
+	if (!wlr_output) {
+		return SNAP_NONE;
+	}
+	*output = output_from_wlr_output(wlr_output);
+	if (!*output) {
+		return SNAP_NONE;
+	}
+	struct wlr_box box;
+	output_get_box(*output, &box);
+	double t = config->floating_snap;
+	double corner = box.height / SNAP_CORNER_SHARE;
+	bool left = lx < box.x + t;
+	bool right = lx >= box.x + box.width - t;
+	bool upper = ly < box.y + corner;
+	bool lower = ly >= box.y + box.height - corner;
+	if (left || right) {
+		if (upper) {
+			return left ? SNAP_TOP_LEFT : SNAP_TOP_RIGHT;
+		}
+		if (lower) {
+			return left ? SNAP_BOTTOM_LEFT : SNAP_BOTTOM_RIGHT;
+		}
+		return left ? SNAP_LEFT : SNAP_RIGHT;
+	}
+	// Not the bottom edge: that is where the dock is, and a window dragged
+	// down there is being put out of the way, not made half the screen.
+	if (ly < box.y + t) {
+		return SNAP_MAXIMIZE;
+	}
+	return SNAP_NONE;
+}
+
+bool snap_zone_box(struct sway_output *output, enum sway_snap_zone zone,
+		struct wlr_box *box) {
+	if (zone == SNAP_NONE || !output) {
+		return false;
+	}
+	// The output's usable area is what bars and panels leave; round it the
+	// gaps a tiled window has (outer and inner), and the inner between.
+	struct sway_workspace *ws = output_get_active_workspace(output);
+	if (!ws) {
+		return false;
+	}
+	int gap = ws->gaps_inner;
+	double top = fmax(0, ws->gaps_outer.top + gap);
+	double right = fmax(0, ws->gaps_outer.right + gap);
+	double bottom = fmax(0, ws->gaps_outer.bottom + gap);
+	double left = fmax(0, ws->gaps_outer.left + gap);
+	// Not the workspace's own box: arranging it takes its gaps off already,
+	// and only while it has tiled windows.
+	double x = output->lx + output->usable_area.x + left;
+	double y = output->ly + output->usable_area.y + top;
+	double w = output->usable_area.width - left - right;
+	double h = output->usable_area.height - top - bottom;
+	// Each half is what is left of the area after the gap between them.
+	double hw = (w - gap) / 2, hh = (h - gap) / 2;
+	double rx = x + hw + gap, by = y + hh + gap;
+
+	switch (zone) {
+	case SNAP_LEFT:         *box = (struct wlr_box){ x, y, hw, h }; break;
+	case SNAP_RIGHT:        *box = (struct wlr_box){ rx, y, hw, h }; break;
+	case SNAP_TOP:          *box = (struct wlr_box){ x, y, w, hh }; break;
+	case SNAP_BOTTOM:       *box = (struct wlr_box){ x, by, w, hh }; break;
+	case SNAP_TOP_LEFT:     *box = (struct wlr_box){ x, y, hw, hh }; break;
+	case SNAP_TOP_RIGHT:    *box = (struct wlr_box){ rx, y, hw, hh }; break;
+	case SNAP_BOTTOM_LEFT:  *box = (struct wlr_box){ x, by, hw, hh }; break;
+	case SNAP_BOTTOM_RIGHT: *box = (struct wlr_box){ rx, by, hw, hh }; break;
+	case SNAP_MAXIMIZE:     *box = (struct wlr_box){ x, y, w, h }; break;
+	case SNAP_NONE:         return false;
+	}
+	return box->width > 0 && box->height > 0;
+}
+
+// The container to the new size, its content with it, as `resize set` does.
+static void container_floating_set_size(struct sway_container *con,
+		double width, double height) {
+	double grow_width = width - con->pending.width;
+	double grow_height = height - con->pending.height;
+	con->pending.width += grow_width;
+	con->pending.height += grow_height;
+	con->pending.content_width += grow_width;
+	con->pending.content_height += grow_height;
+	node_set_dirty(&con->node);
+}
+
+void container_snap(struct sway_container *con, struct sway_output *output,
+		enum sway_snap_zone zone) {
+	struct wlr_box box;
+	if (!container_is_floating(con) || !snap_zone_box(output, zone, &box)) {
+		return;
+	}
+	if (con->snap_zone == SNAP_NONE) {
+		con->snap_restore_width = con->pending.width;
+		con->snap_restore_height = con->pending.height;
+	}
+	con->snap_zone = zone;
+	container_floating_set_size(con, box.width, box.height);
+	// Moved last: that is what takes it to the output's workspace.
+	container_floating_move_to(con, box.x, box.y);
+}
+
+void container_unsnap(struct sway_container *con, double lx, double ly) {
+	if (con->snap_zone == SNAP_NONE) {
+		return;
+	}
+	con->snap_zone = SNAP_NONE;
+	if (!container_is_floating(con)) {
+		return;
+	}
+	container_floating_set_size(con,
+		con->snap_restore_width, con->snap_restore_height);
+	container_floating_move_to(con, lx, ly);
+}
