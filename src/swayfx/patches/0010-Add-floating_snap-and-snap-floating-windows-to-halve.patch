diff --git a/sway/commands/floating_snap.c b/sway/commands/floating_snap.c
new file mode 100644
index 0000000..e8ae83b
--- /dev/null
+++ b/sway/commands/floating_snap.c
@@ -0,0 +1,30 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/config.h"
+
+// floating_snap <px>|off
+//
+// A floating window dragged to within this many pixels of its output's left
+// or right edge snaps to that half of the screen, near the top or bottom of
+// the edge to a quarter, and to the top edge to all of it; a preview shows
+// where while it is held there. Dragging it away gives it its size back.
+// 0 or off (the default) turns it off; `snap` works either way.
+struct cmd_results *cmd_floating_snap(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "floating_snap", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	if (strcasecmp(argv[0], "off") == 0) {
+		config->floating_snap = 0;
+		return cmd_results_new(CMD_SUCCESS, NULL);
+	}
+	char *end;
+	long value = strtol(argv[0], &end, 10);
+	if (*end || end == argv[0] || value < 0 || value > 1000) {
+		return cmd_results_new(CMD_INVALID,
+			"floating_snap takes a distance in pixels from 0 to 1000, or off");
+	}
+	config->floating_snap = value;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
diff --git a/sway/commands/snap.c b/sway/commands/snap.c
new file mode 100644
index 0000000..de88b93
--- /dev/null
+++ b/sway/commands/snap.c
@@ -0,0 +1,53 @@
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/desktop/transaction.h"
+#include "sway/output.h"
+#include "sway/tree/arrange.h"
+#include "sway/tree/container.h"
+#include "sway/tree/snap.h"
+#include "sway/tree/workspace.h"
+
+// snap left|right|top|bottom|top-left|top-right|bottom-left|bottom-right|
+//      maximize|restore
+//
+// The floating window to that half, quarter or all of its output's usable
+// area, as dragging it to an edge does with floating_snap on; `restore`
+// gives it the size it had before, centred where it is.
+struct cmd_results *cmd_snap(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "snap", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	struct sway_container *con = config->handler_context.container;
+	if (!con) {
+		return cmd_results_new(CMD_FAILURE, "No window to snap");
+	}
+	con = container_toplevel_ancestor(con);
+	if (!container_is_floating(con) || con->pending.fullscreen_mode) {
+		return cmd_results_new(CMD_FAILURE, "Only a floating window snaps");
+	}
+	struct sway_output *output = con->pending.workspace ?
+		con->pending.workspace->output : NULL;
+	if (!output) {
+		return cmd_results_new(CMD_FAILURE, "The window is on no output");
+	}
+
+	if (strcasecmp(argv[0], "restore") == 0) {
+		if (con->snap_zone != SNAP_NONE) {
+			double cx = con->pending.x + con->pending.width / 2;
+			double cy = con->pending.y + con->pending.height / 2;
+			container_unsnap(con, cx - con->snap_restore_width / 2,
+				cy - con->snap_restore_height / 2);
+		}
+	} else {
+		enum sway_snap_zone zone = snap_zone_parse(argv[0]);
+		if (zone == SNAP_NONE) {
+			return cmd_results_new(CMD_INVALID, "Expected snap left|right|top|"
+				"bottom|top-left|top-right|bottom-left|bottom-right|maximize|"
+				"restore");
+		}
+		container_snap(con, output, zone);
+	}
+	arrange_container(con);
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
