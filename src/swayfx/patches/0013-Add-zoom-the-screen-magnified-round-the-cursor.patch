diff --git a/sway/commands/zoom.c b/sway/commands/zoom.c
new file mode 100644
index 0000000..d63ddfa
--- /dev/null
+++ b/sway/commands/zoom.c
@@ -0,0 +1,38 @@
+#include <stdlib.h>
+#include <strings.h>
+#include "sway/commands.h"
+#include "sway/desktop/zoom.h"
+
+// How much `zoom in` and `zoom out` change it by.
+#define ZOOM_STEP 1.25f
+
+// zoom <factor>|in|out|reset|toggle
+//
+// Magnifies the screen round the cursor, from 1 (off) to 10; the part shown
+// follows the cursor. `toggle` goes between off and 2, as Mod+Ctrl+scroll
+// and Mod+Ctrl+0 do in b1air.
+struct cmd_results *cmd_zoom(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "zoom", EXPECTED_EQUAL_TO, 1))) {
+		return error;
+	}
+	float now = zoom_factor();
+	if (strcasecmp(argv[0], "in") == 0) {
+		zoom_set(now * ZOOM_STEP);
+	} else if (strcasecmp(argv[0], "out") == 0) {
+		zoom_set(now / ZOOM_STEP < 1.05f ? 1.0f : now / ZOOM_STEP);
+	} else if (strcasecmp(argv[0], "reset") == 0 || strcasecmp(argv[0], "off") == 0) {
+		zoom_set(1.0f);
+	} else if (strcasecmp(argv[0], "toggle") == 0) {
+		zoom_set(now > 1.0f ? 1.0f : 2.0f);
+	} else {
+		char *end;
+		float value = strtof(argv[0], &end);
+		if (*end || end == argv[0] || value < 1.0f || value > 10.0f) {
+			return cmd_results_new(CMD_INVALID,
+				"zoom takes a factor from 1 to 10, or in, out, reset or toggle");
+		}
+		zoom_set(value);
+	}
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
diff --git a/sway/desktop/zoom.c b/sway/desktop/zoom.c
new file mode 100644
index 0000000..a3339ad
--- /dev/null
+++ b/sway/desktop/zoom.c
@@ -0,0 +1,99 @@
+#include <math.h>
+#include <scenefx/types/wlr_scene.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_output_layout.h>
+#include "sway/animation_manager.h"
+#include "sway/config.h"
+#include "sway/desktop/zoom.h"
+#include "sway/input/cursor.h"
+#include "sway/input/input-manager.h"
+#include "sway/input/seat.h"
+#include "sway/output.h"
+#include "sway/tree/root.h"
+
+static struct {
+	float scale;        // drawn at now
+	float from, to;     // what the animation runs between
+	struct animation anim;
+	bool anim_ready;
+	struct sway_output *output;  // the one magnified, NULL when none
+} zoom = { .scale = 1.0f, .from = 1.0f, .to = 1.0f };
+
+float zoom_factor(void) {
+	return zoom.to;
+}
+
+// The scene magnified about the cursor (scenefx's wlr_scene_set_zoom): what
+// is under it stays there. Only drawing and finding what is under the cursor
+// see it; where things are placed does not change.
+static void zoom_place(void) {
+	struct sway_seat *seat = input_manager_current_seat();
+	double cx = 0, cy = 0;
+	if (seat && seat->cursor) {
+		cx = seat->cursor->cursor->x;
+		cy = seat->cursor->cursor->y;
+	}
+	// Only the output the cursor is on; the others are drawn as usual.
+	struct wlr_box area = {0};
+	struct wlr_output *wlr_output =
+		wlr_output_layout_output_at(root->output_layout, cx, cy);
+	struct sway_output *output = wlr_output ? output_from_wlr_output(wlr_output) : NULL;
+	if (output) {
+		output_get_box(output, &area);
+	}
+	zoom.output = zoom.scale != 1.0f ? output : NULL;
+	wlr_scene_set_zoom(root->root_scene, zoom.scale, cx, cy, &area);
+}
+
+struct sway_output *zoom_output(void) {
+	return zoom.output;
+}
+
+void zoom_follow_cursor(void) {
+	if (zoom.scale != 1.0f) {
+		zoom_place();
+	}
+}
+
+static void zoom_update(void *data) {
+	zoom.scale = zoom.from + (zoom.to - zoom.from) * zoom.anim.multiplier;
+	zoom_place();
+}
+
+static void zoom_complete(void *data) {
+	zoom.scale = zoom.to;
+	zoom_place();
+}
+
+void zoom_set(float factor) {
+	if (factor < 1.0f) {
+		factor = 1.0f;
+	} else if (factor > 10.0f) {
+		factor = 10.0f;
+	}
+	if (factor == zoom.to) {
+		return;
+	}
+	if (!zoom.anim_ready) {
+		zoom.anim = init_animation(NULL);
+		zoom.anim_ready = true;
+	}
+	finish_animation(&zoom.anim);
+	zoom.from = zoom.scale;
+	zoom.to = factor;
+	if (!config->animation_duration_ms) {
+		zoom_complete(NULL);
+		return;
+	}
+	add_animation(&zoom.anim, zoom_update, zoom_complete);
+	start_animations();
+}
+
+void zoom_output_gone(struct sway_output *output) {
+	if (zoom.output != output) {
+		return;
+	}
+	// Nothing magnified until the cursor is on an output again.
+	zoom.output = NULL;
+	wlr_scene_set_zoom(root->root_scene, zoom.scale, 0, 0, NULL);
+}
