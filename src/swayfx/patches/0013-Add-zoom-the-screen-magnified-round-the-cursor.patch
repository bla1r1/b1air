new file mode 100644
index 0000000..40c7f56
--- /dev/null
+++ b/include/sway/desktop/zoom.h
@@ -0,0 +1,19 @@
+#ifndef _SWAY_DESKTOP_ZOOM_H
+#define _SWAY_DESKTOP_ZOOM_H
+
+// b1air: the screen magnified round the cursor (zoom <factor>|in|out|reset|
+// toggle). Everything is drawn larger about the point under the cursor,
+// which stays where it is, so what is under the cursor is what is pointed
+// at, and input needs nothing changed. Only the output the cursor is on.
+
+float zoom_factor(void);       // what it is going to, 1 when off
+void zoom_set(float factor);   // animated with animation_duration_ms
+// The output magnified: the one the cursor is on, NULL when off.
+struct sway_output;
+struct sway_output *zoom_output(void);
+// The output is going away: not magnified any more.
+void zoom_output_gone(struct sway_output *output);
+// The cursor moved: the magnified part follows it, to another output too.
+void zoom_follow_cursor(void);
+
+#endif
