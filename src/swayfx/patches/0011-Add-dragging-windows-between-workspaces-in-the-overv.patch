+// The shown workspace whose cell holds the point (layout coordinates), or
+// -1; `list` is shown_workspaces().
+static int overview_cell_at(list_t *list, double lx, double ly) {
+	struct sway_output *output = ov.output;
+	double ox = lx - output->lx, oy = ly - output->ly;
+	for (int i = 0; i < list->length; i++) {
+		struct wlr_box cell;
+		float s;
+		overview_cell(output, i, list->length, &cell, &s);
+		if (wlr_box_contains_point(&cell, ox, oy)) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+struct window_at {
+	double x, y; // in the workspace's own layout, unscaled
+};
+
+static bool window_at_test(struct sway_container *con, void *data) {
+	struct window_at *at = data;
+	struct wlr_box box = {
+		con->current.x, con->current.y, con->current.width, con->current.height,
+	};
+	return con->view && wlr_box_contains_point(&box, at->x, at->y);
+}
+
+// The tiled window of cell i under the point, and where in it, scaled.
+static struct sway_container *overview_window_at(list_t *list, int i,
+		double lx, double ly, double *grab_x, double *grab_y, struct wlr_box *size) {
+	struct sway_output *output = ov.output;
+	struct sway_workspace *ws = list->items[i];
+	struct wlr_box cell;
+	float s;
+	overview_cell(output, i, list->length, &cell, &s);
+	// The cell shows the workspace from its gaps in, at scale s: back to
+	// where the point would be on the workspace drawn at full size.
+	double ox = lx - output->lx - cell.x - ws->current_gaps.left * s;
+	double oy = ly - output->ly - cell.y - ws->current_gaps.top * s;
+	struct window_at at = {
+		ws->current.x + ox / s, ws->current.y + oy / s,
+	};
+	struct sway_container *con = workspace_find_container(ws, window_at_test, &at);
+	if (con) {
+		*grab_x = (at.x - con->current.x) * s;
+		*grab_y = (at.y - con->current.y) * s;
+		size->width = (int)lround(con->current.width * s);
+		size->height = (int)lround(con->current.height * s);
+	}
+	return con;
+}
+
 static float lerp(float a, float b, float t) {
 	return a + (b - a) * t;
 }
