 }
 
+// Sends the window to the workspace, as `move container to workspace`.
+static void overview_move_window(struct sway_container *con,
+		struct sway_workspace *ws) {
+	struct sway_seat *seat = input_manager_current_seat();
+	// The name quoted as one argument; a quote in it escaped.
+	size_t len = strlen(ws->name);
+	char *name = calloc(2 * len + 1, 1);
+	if (!name) {
+		return;
+	}
+	for (size_t i = 0, j = 0; i < len; i++) {
+		if (ws->name[i] == '"' || ws->name[i] == '\\') {
+			name[j++] = '\\';
+		}
+		name[j++] = ws->name[i];
+	}
+	char *command = format_str("move container to workspace \"%s\"", name);
+	free(name);
+	if (!command) {
+		return;
+	}
+	list_t *results = execute_command(command, seat, con);
+	free(command);
+	for (int i = 0; i < results->length; i++) {
+		free_cmd_results(results->items[i]);
+	}
+	list_free(results);
+	transaction_commit_dirty();
+}
+
 bool overview_handle_button(double lx, double ly, bool pressed) {
 	if (!ov.output || ov.closing) {
 		return false;
 	}
-	if (!pressed) {
+	list_t *list = shown_workspaces(ov.output);
+	int at = overview_cell_at(list, lx, ly);
+
+	if (pressed) {
+		overview_press_end();
+		ov.press.down = true;
+		ov.press.lx = lx;
+		ov.press.ly = ly;
+		ov.press.from = at;
+		if (at >= 0) {
+			ov.press.con = overview_window_at(list, at, lx, ly,
+				&ov.press.grab_x, &ov.press.grab_y, &ov.press.size);
+		}
+		list_free(list);
 		return true;
 	}
-	struct sway_output *output = ov.output;
-	double ox = lx - output->lx, oy = ly - output->ly;
-	list_t *list = shown_workspaces(output);
-	struct sway_workspace *picked = NULL;
-	for (int i = 0; i < list->length; i++) {
-		struct wlr_box cell;
-		float s;
-		overview_cell(output, i, list->length, &cell, &s);
-		if (wlr_box_contains_point(&cell, ox, oy)) {
-			picked = list->items[i];
-		}
+	if (!ov.press.down) {
+		list_free(list);
+		return true;
 	}
+
+	// Let go: a window taken to another workspace goes there and the
+	// overview stays, to see it land; a click goes to the workspace it was
+	// on, and beside them all leaves.
+	bool moved = hypot(lx - ov.press.lx, ly - ov.press.ly) > OVERVIEW_DRAG_THRESHOLD;
+	struct sway_container *con = ov.press.con;
+	int from = ov.press.from;
+	overview_press_end();
+	if (con && moved && at >= 0 && at != from) {
+		struct sway_workspace *ws = list->items[at];
+		list_free(list);
+		ov.selected = at;
+		overview_move_window(con, ws);
+		overview_place();
+		return true;
+	}
+	struct sway_workspace *picked = !moved || at == from ?
+		(from >= 0 ? list->items[from] : NULL) : NULL;
 	list_free(list);
-	// A click beside every workspace just leaves.
+	if (moved && at != from) {
+		// Dragged from one place to another with nothing in hand.
+		return true;
+	}
 	overview_go(picked);
 	return true;
 }
 
+bool overview_handle_motion(double lx, double ly) {
+	if (!ov.output || ov.closing) {
+		return false;
+	}
+	if (!ov.press.down || !ov.press.con) {
+		return true;
+	}
+	if (!ov.press.dragging) {
+		if (hypot(lx - ov.press.lx, ly - ov.press.ly) <= OVERVIEW_DRAG_THRESHOLD) {
+			return true;
+		}
+		ov.press.dragging = true;
+		// The window in hand, as a pane of the indicator colour its size
+		// in the overview, over everything.
+		const float *c = config->border_colors.focused.indicator;
+		float color[4] = { c[0] * .5f, c[1] * .5f, c[2] * .5f, .5f };
+		struct sway_seat *seat = input_manager_current_seat();
+		ov.press.ghost = wlr_scene_rect_create(seat->scene_tree,
+			ov.press.size.width, ov.press.size.height, color);
+		if (ov.press.ghost) {
+			int r = MIN(config->corner_radius,
+				MIN(ov.press.size.width / 2, ov.press.size.height / 2));
+			wlr_scene_rect_set_corner_radii(ov.press.ghost, corner_radii_all(r));
+		}
+		cursor_set_image(seat->cursor, "grabbing", NULL);
+	}
+	if (ov.press.ghost) {
+		wlr_scene_node_set_position(&ov.press.ghost->node,
+			(int)lround(lx - ov.press.grab_x), (int)lround(ly - ov.press.grab_y));
+	}
+	// The workspace it would go to is the one picked.
+	list_t *list = shown_workspaces(ov.output);
+	int at = overview_cell_at(list, lx, ly);
+	list_free(list);
+	if (at >= 0 && at != ov.selected) {
+		ov.selected = at;
+		overview_place();
+	}
+	return true;
+}
+
+void overview_container_gone(struct sway_container *con) {
+	if (ov.press.con == con) {
+		overview_press_end();
+	}
+}
+
 bool overview_handle_key(xkb_keysym_t sym) {
 	if (!ov.output || ov.closing) {
 		return false;
